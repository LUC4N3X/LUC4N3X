---
import SectionHeader from './SectionHeader.astro';
import Button from './Button.astro';
import { siteConfig } from '../data/site';
---

<section class="py-20 sm:py-28 border-t border-[#24211d] bg-[#0e0d0c] relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="max-w-3xl mx-auto text-center flex flex-col items-center">
      <SectionHeader
        eyebrow="Direct Communication"
        title="Get in Touch"
        subtitle="For software inquiries, security disclosures, bug reports, or open-source collaboration, use the official channels below."
        align="center"
      />

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 w-full mb-10">
        <a 
          href={`mailto:${siteConfig.email}`}
          class="flex flex-col items-center p-8 rounded-3xl bg-[#171513] border border-[#27231e] hover:border-[#3d372f] transition-all group"
        >
          <div class="w-12 h-12 rounded-full bg-[#1c1916] border border-[#2e2a25] text-[#f7f5f2] flex items-center justify-center mb-4">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
          </div>
          <span class="text-base font-semibold text-[#f7f5f2] mb-1">Direct Email</span>
          <span class="text-xs font-mono text-[#34a896]">{siteConfig.email}</span>
        </a>

        <a 
          href={siteConfig.github}
          target="_blank"
          rel="noopener noreferrer"
          class="flex flex-col items-center p-8 rounded-3xl bg-[#171513] border border-[#27231e] hover:border-[#3d372f] transition-all group"
        >
          <div class="w-12 h-12 rounded-full bg-[#1c1916] border border-[#2e2a25] text-[#f7f5f2] flex items-center justify-center mb-4">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd" />
            </svg>
          </div>
          <span class="text-base font-semibold text-[#f7f5f2] mb-1">GitHub Profile</span>
          <span class="text-xs font-mono text-[#34a896]">@LUC4N3X</span>
        </a>
      </div>

      <div class="flex items-center gap-3">
        <Button href={`mailto:${siteConfig.email}`} variant="primary" size="md">
          <span>Send an Email</span>
        </Button>
        <Button href="/contact" variant="secondary" size="md">
          <span>Contact Details</span>
        </Button>
      </div>
    </div>
  </div>
</section>
