---
interface Props {
  fill?: string;
  flip?: boolean;
  className?: string;
}

const { fill = "#080b11", flip = false, className = "" } = Astro.props;
---

<div class={`relative w-full overflow-hidden leading-none select-none pointer-events-none -my-1 z-10 ${className}`}>
  <svg 
    class={`block w-full h-14 sm:h-20 md:h-24 lg:h-28 ${flip ? 'rotate-180' : ''}`} 
    viewBox="0 0 1440 140" 
    fill="none" 
    preserveAspectRatio="none"
  >
    <path 
      d="M0,60 C120,20 220,75 340,40 C460,5 560,55 680,25 C800,-5 900,45 1020,20 C1140,-10 1260,50 1440,30 L1440,140 L0,140 Z" 
      fill={fill} 
      fill-opacity="0.3" 
    />
    <path 
      d="M0,80 C140,45 260,95 400,60 C540,25 660,85 800,50 C940,15 1060,75 1200,45 C1320,20 1380,60 1440,50 L1440,140 L0,140 Z" 
      fill={fill} 
      fill-opacity="0.65" 
    />
    <path 
      d="M0,100 C110,75 210,110 320,85 C440,55 540,105 660,80 C780,50 890,95 1010,70 C1130,45 1240,90 1350,75 C1400,68 1420,78 1440,75 L1440,140 L0,140 Z" 
      fill={fill} 
    />
  </svg>
</div>
