---
import Clouds from './Clouds.astro';

/**
 * Horizon between two sections. `fill` is the colour of the section below,
 * which the nearest cloud layer is painted in so the seam disappears.
 * `crestFill` and `midFill` are kept for call-site compatibility; cloud
 * shading now comes from the gradients in Clouds.astro.
 */
interface Props {
  fill?: string;
  crestFill?: string;
  midFill?: string;
  flip?: boolean;
  className?: string;
}

const { fill = '#080b11', flip = false, className = '' } = Astro.props;
---

<Clouds variant="band" base={fill} flip={flip} class={`z-20 ${className}`} />
