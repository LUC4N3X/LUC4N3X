---
import Button from './Button.astro';
import TechBadge from './TechBadge.astro';
import CloudDivider from './CloudDivider.astro';
import { getLevyraMetrics } from '../utils/github';

const metrics = await getLevyraMetrics();
const starsFormatted = metrics.stars >= 1000
  ? `${(metrics.stars / 1000).toFixed(1).replace(/\.0$/, '')}k`
  : String(metrics.stars);
const downloadsFormatted = metrics.downloads >= 1000
  ? `${(metrics.downloads / 1000).toFixed(1).replace(/\.0$/, '')}k`
  : String(metrics.downloads);
---

<section class="relative pt-16 sm:pt-24 pb-20 sm:pb-32 bg-gradient-to-b from-[#080b11] via-[#091428] to-[#0d1d3a] overflow-hidden">
  <div class="absolute inset-0 overflow-hidden pointer-events-none -z-0">
    <div class="absolute top-1/2 right-1/4 w-[500px] h-[350px] bg-sky-500/10 rounded-full blur-[120px]"></div>
    <div class="absolute bottom-10 left-10 w-[400px] h-[250px] bg-indigo-500/10 rounded-full blur-[100px]"></div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16 items-center">
      
      <div class="lg:col-span-7 flex flex-col gap-6">
        <div class="flex items-center gap-2 text-xs font-mono uppercase tracking-widest text-[#38bdf8] font-semibold">
          <span class="w-1.5 h-1.5 rounded-full bg-[#38bdf8]"></span>
          <span>Featured Project</span>
        </div>

        <h2 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-extrabold text-white tracking-tight leading-[1.1]">
          Levyra <span class="text-transparent bg-clip-text bg-gradient-to-r from-[#38bdf8] via-[#818cf8] to-[#f43f5e]">DeepSound</span>
        </h2>

        <p class="text-base sm:text-lg text-zinc-300 font-normal leading-relaxed">
          A high-fidelity, zero-telemetry music player for Android and Windows. Built from scratch with AndroidX Media3 and Jetpack Compose to deliver gapless playback, synchronized lyrics, and uncompromising privacy.
        </p>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 sm:gap-6 pt-2">
          <div class="space-y-1.5 border-l-2 border-sky-500/40 pl-3.5">
            <h3 class="text-sm font-semibold text-white tracking-tight">Media3 Audio Core</h3>
            <p class="text-xs text-zinc-400 leading-relaxed">Adaptive ring buffering to eliminate OEM background service terminations.</p>
          </div>
          <div class="space-y-1.5 border-l-2 border-indigo-500/40 pl-3.5">
            <h3 class="text-sm font-semibold text-white tracking-tight">Zero Telemetry</h3>
            <p class="text-xs text-zinc-400 leading-relaxed">Direct TLS 1.3 streams. All listening history stays in on-device Room SQLite.</p>
          </div>
          <div class="space-y-1.5 border-l-2 border-rose-500/40 pl-3.5">
            <h3 class="text-sm font-semibold text-white tracking-tight">Synced Lyrics</h3>
            <p class="text-xs text-zinc-400 leading-relaxed">Real-time line-by-line synced lyrics via LRCLIB with offline caching.</p>
          </div>
        </div>

        <div class="flex flex-wrap items-center gap-1.5 sm:gap-2 pt-1">
          <TechBadge text="Android" variant="blue" />
          <TechBadge text="Windows" variant="blue" />
          <TechBadge text="GPL-3.0" variant="blue" />
          <TechBadge text="Kotlin" variant="default" />
          <TechBadge text="Jetpack Compose" variant="default" />
          <TechBadge text="AndroidX Media3" variant="default" />
          <TechBadge text="ExoPlayer" variant="default" />
          <TechBadge text="Room SQLite" variant="default" />
          <TechBadge text="LRCLIB" variant="default" />
          <TechBadge text="libvlc" variant="default" />
        </div>

        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-6 pt-6 border-t border-white/[0.08]">
          <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3 w-full sm:w-auto">
            <Button href="/projects/levyra" variant="primary" size="md" class="w-full sm:w-auto">
              <span>Explore Architecture</span>
              <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
            </Button>

            <Button href="https://github.com/LUC4N3X/Levyra-deepsound" target="_blank" variant="secondary" size="md" class="w-full sm:w-auto">
              <svg class="w-4 h-4 mr-1 text-zinc-400" fill="currentColor" viewBox="0 0 24 24">
                <path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd" />
              </svg>
              <span>GitHub Repository</span>
            </Button>

            <Button href="https://github.com/LUC4N3X/Levyra-deepsound/releases/latest" target="_blank" variant="outline" size="md" class="w-full sm:w-auto">
              <span>Latest Release</span>
              <span data-levyra-version class="font-mono text-xs ml-1 text-[#38bdf8]">v{metrics.version}</span>
            </Button>
          </div>

          <div class="flex items-center justify-around sm:justify-start gap-6 text-xs font-mono text-zinc-400 pt-3 sm:pt-0 border-t border-white/[0.05] sm:border-t-0">
            <div data-levyra-stars-container>
              <span class="text-zinc-500 block">Stars</span>
              <span data-levyra-stars class="text-sm font-semibold text-white">{starsFormatted}</span>
            </div>
            <div data-levyra-downloads-container>
              <span class="text-zinc-500 block">Downloads</span>
              <span data-levyra-downloads class="text-sm font-semibold text-white">{downloadsFormatted}</span>
            </div>
          </div>
        </div>
      </div>

      <div class="lg:col-span-5 flex flex-col items-center justify-center relative">
        <div class="relative w-full max-w-[340px] sm:max-w-[420px] mx-auto flex flex-col items-center justify-center">
          <div class="absolute -inset-10 bg-gradient-to-tr from-[#38bdf8]/30 via-[#818cf8]/25 to-[#f43f5e]/30 rounded-full blur-3xl opacity-80 pointer-events-none"></div>
          
          <img 
            src="/assets/levyra/levyra-logo-3d.png" 
            alt="Levyra DeepSound 3D Logo" 
            class="relative z-10 w-full max-w-[260px] sm:max-w-[340px] lg:max-w-[400px] h-auto object-contain drop-shadow-[0_30px_60px_rgba(0,0,0,0.7)] hover:scale-105 transition-transform duration-500 ease-out" 
            loading="lazy"
            width="400" 
            height="400" 
          />
        </div>
      </div>

    </div>

  </div>

  <div class="relative w-full overflow-hidden leading-none select-none pointer-events-none -mb-1 z-20 mt-12 sm:mt-20">
    <CloudDivider fill="#080b11" />
  </div>
</section>
