---
import Button from './Button.astro';
import TechBadge from './TechBadge.astro';
---

<section class="relative py-20 sm:py-28 border-t border-white/[0.08] bg-[#000000] overflow-hidden">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 relative">
    <div class="rounded-3xl border border-white/[0.08] bg-[#0c0c0e] p-8 sm:p-12 relative overflow-hidden transition-all duration-300 hover:border-white/[0.14]">
      <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-6 pb-8 mb-8 border-b border-white/[0.08]">
        <div>
          <div class="inline-flex items-center gap-2 mb-3">
            <span class="text-xs font-mono tracking-widest text-[#2997ff] uppercase font-semibold">
              FLAGSHIP OPEN SOURCE PROJECT
            </span>
          </div>
          <h2 class="text-3xl sm:text-4xl md:text-5xl font-semibold text-white tracking-tight">
            Levyra (DeepSound)
          </h2>
          <p class="text-base sm:text-lg text-zinc-400 mt-2 font-normal max-w-2xl">
            High-fidelity, zero-telemetry Android audio player built with AndroidX Media3 and Jetpack Compose.
          </p>
        </div>

        <div class="flex flex-wrap items-center gap-2">
          <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-mono bg-white/[0.04] border border-white/[0.08] text-zinc-300">
            <svg class="w-3.5 h-3.5 text-white" viewBox="0 0 24 24" fill="currentColor">
              <path d="M17.523 15.3414c-.5511 0-.9993-.4486-.9993-.9997s.4482-.9993.9993-.9993c.551 0 .9993.4482.9993.9993s-.4483.9997-.9993.9997m-11.046 0c-.5511 0-.9993-.4486-.9993-.9997s.4482-.9993.9993-.9993c.5511 0 .9994.4482.9994.9993s-.4483.9997-.9994.9997m11.4045-6.02l1.9973-3.4592a.416.416 0 00-.1521-.5676.416.416 0 00-.5676.1521l-2.0223 3.503C15.5902 8.4107 13.8533 8 12 8s-3.5902.4107-5.1367.9507L4.841 5.4477a.416.416 0 00-.5677-.1521.416.416 0 00-.1521.5676l1.9973 3.4592C2.6889 11.1867.3432 14.6589 0 18.761h24c-.3432-4.1021-2.6889-7.5743-6.1185-9.4396"/>
            </svg>
            Android
          </span>
          <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-mono bg-white/[0.04] border border-white/[0.08] text-zinc-300">
            <svg class="w-3.5 h-3.5 text-white" viewBox="0 0 24 24" fill="currentColor">
              <path d="M0 3.449L9.75 2.1v9.451H0m10.949-9.602L24 0v11.551H10.949M0 12.6h9.75v9.451L0 20.699M10.949 12.6H24V24l-12.95-1.801"/>
            </svg>
            Windows
          </span>
          <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-mono bg-white/[0.04] border border-white/[0.08] text-zinc-300">
            GPL-3.0
          </span>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-10">
        <div>
          <h3 class="text-sm font-semibold text-white uppercase tracking-wider mb-2 font-mono text-[#2997ff]">
            Adaptive Audio Engine
          </h3>
          <p class="text-sm text-zinc-400 leading-relaxed">
            ExoPlayer with custom ring-buffering, low-latency decode pipelines, and foreground service lifecycle resilience across diverse OEM Android distributions.
          </p>
        </div>

        <div>
          <h3 class="text-sm font-semibold text-white uppercase tracking-wider mb-2 font-mono text-[#2997ff]">
            Zero Telemetry Privacy
          </h3>
          <p class="text-sm text-zinc-400 leading-relaxed">
            Direct TLS 1.3 stream handshakes without intermediary analytics proxies, user tracking SDKs, or remote data retention. Your listening stays on-device.
          </p>
        </div>

        <div>
          <h3 class="text-sm font-semibold text-white uppercase tracking-wider mb-2 font-mono text-[#2997ff]">
            Synced Lyrics & Metadata
          </h3>
          <p class="text-sm text-zinc-400 leading-relaxed">
            Real-time synchronized scrolling with LRCLIB integration, automatic ID3 tag embedding, and local SQLite caching for instantaneous offline access.
          </p>
        </div>

        <div>
          <h3 class="text-sm font-semibold text-white uppercase tracking-wider mb-2 font-mono text-[#2997ff]">
            Bundled Extraction Subsystem
          </h3>
          <p class="text-sm text-zinc-400 leading-relaxed">
            Internal media extraction engine with AST analysis and dynamic token evaluation, completely decoupled from brittle regular expressions.
          </p>
        </div>
      </div>

      <div class="flex flex-wrap items-center gap-2 mb-10">
        <TechBadge text="Kotlin" variant="blue" />
        <TechBadge text="Jetpack Compose" variant="blue" />
        <TechBadge text="AndroidX Media3" variant="default" />
        <TechBadge text="ExoPlayer" variant="default" />
        <TechBadge text="Room SQLite" variant="default" />
        <TechBadge text="LRCLIB" variant="default" />
        <TechBadge text="libvlc" variant="default" />
      </div>

      <div class="flex flex-wrap items-center justify-between gap-4 pt-8 border-t border-white/[0.08]">
        <div class="flex flex-wrap items-center gap-3">
          <Button href="/projects/levyra" variant="primary" size="md">
            <span>Explore Levyra</span>
            <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </Button>

          <Button href="https://github.com/LUC4N3X/Levyra-deepsound" target="_blank" variant="secondary" size="md">
            <span>GitHub Repository</span>
            <svg class="w-3.5 h-3.5 ml-1 text-zinc-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
            </svg>
          </Button>

          <Button href="https://github.com/LUC4N3X/Levyra-deepsound/releases/latest" target="_blank" variant="outline" size="md">
            <span>Latest Release</span>
            <span data-levyra-version class="font-mono text-xs hidden"></span>
          </Button>
        </div>

        <div class="flex items-center gap-6 text-xs font-mono text-zinc-400">
          <div>
            <span class="text-zinc-500 block">Stars</span>
            <span data-levyra-stars class="text-sm font-semibold text-white">-</span>
          </div>
          <div>
            <span class="text-zinc-500 block">Downloads</span>
            <span data-levyra-downloads class="text-sm font-semibold text-white">-</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
