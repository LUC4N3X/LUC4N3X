---
import { projects } from '../data/projects';
import { getLevyraMetrics, formatMetricNumber } from '../utils/github';

const levyra = projects.find(p => p.id === 'levyra')!;
const metrics = await getLevyraMetrics();
const starsFormatted = formatMetricNumber(metrics.stars);
const downloadsFormatted = formatMetricNumber(metrics.downloads);
---

<section class="py-12 sm:py-20 bg-[#07090e] relative">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    
    <div class="relative rounded-3xl border border-white/[0.08] bg-gradient-to-b from-[#0d111a] to-[#080b11] p-6 sm:p-10 lg:p-12 overflow-hidden shadow-2xl">
      <div class="absolute -top-40 -right-40 w-96 h-96 bg-[#818cf8]/10 rounded-full blur-3xl pointer-events-none"></div>
      <div class="absolute -bottom-40 -left-40 w-96 h-96 bg-[#38bdf8]/10 rounded-full blur-3xl pointer-events-none"></div>

      <div class="relative z-10 grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">
        
        <div class="lg:col-span-7 flex flex-col items-start text-left">
          <div class="flex flex-wrap items-center gap-2.5 mb-5">
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-indigo-500/10 border border-indigo-400/20 text-indigo-300 text-xs font-mono">
              <span class="w-1.5 h-1.5 rounded-full bg-indigo-400"></span>
              <span>Flagship Open Source Project</span>
              <span data-levyra-version class="font-mono text-xs ml-1 text-[#38bdf8]">v{metrics.version}</span>
            </div>

            <div data-levyra-stars-container class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-white/[0.04] border border-white/[0.08]">
              <svg class="w-3.5 h-3.5 text-amber-400" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
              <span data-levyra-stars class="text-xs font-semibold text-white">{starsFormatted}</span>
              <span class="text-[11px] font-mono text-slate-400">stars</span>
            </div>

            <div data-levyra-downloads-container class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-white/[0.04] border border-white/[0.08]">
              <svg class="w-3.5 h-3.5 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/></svg>
              <span data-levyra-downloads class="text-xs font-semibold text-white">{downloadsFormatted}</span>
              <span class="text-[11px] font-mono text-slate-400">downloads</span>
            </div>
          </div>

          <h2 class="text-3xl sm:text-5xl font-extrabold tracking-tight text-white mb-4 leading-[1.1]">
            Levyra <span class="text-slate-400 font-light">DeepSound</span>
          </h2>

          <p class="text-base sm:text-lg text-slate-300 max-w-xl mb-6 leading-relaxed font-normal">
            A native music player for <strong class="text-slate-100 font-medium">Android and Windows</strong> built with Kotlin Multiplatform, Jetpack Media3, and libVLC. It plays verified 320 kbps AAC streams and local lossless files, restores high frequencies on low-bitrate tracks, and stores everything locally with zero telemetry.
          </p>

          <div class="flex flex-wrap gap-2 mb-8">
            <span class="text-xs font-mono px-2.5 py-1 rounded-lg bg-white/[0.04] border border-white/[0.08] text-slate-300">Verified 320 kbps &amp; FLAC</span>
            <span class="text-xs font-mono px-2.5 py-1 rounded-lg bg-white/[0.04] border border-white/[0.08] text-slate-300">Enhanced Audio DSP</span>
            <span class="text-xs font-mono px-2.5 py-1 rounded-lg bg-white/[0.04] border border-white/[0.08] text-slate-300">Word-Synced Lyrics</span>
            <span class="text-xs font-mono px-2.5 py-1 rounded-lg bg-white/[0.04] border border-white/[0.08] text-slate-300">37 Languages</span>
          </div>

          <div class="flex flex-wrap items-center gap-3.5">
            <a 
              href="/projects/levyra" 
              class="inline-flex items-center gap-2 px-6 py-3 rounded-full bg-[#38bdf8] hover:bg-[#0ea5e9] text-slate-950 font-bold text-sm transition-all shadow-lg shadow-sky-500/20"
            >
              <span>Project Overview</span>
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
            </a>
            <a 
              href={levyra.releasesUrl} 
              target="_blank" 
              rel="noopener noreferrer" 
              class="inline-flex items-center gap-2 px-5 py-3 rounded-full bg-white/[0.05] hover:bg-white/[0.1] text-white font-semibold text-sm border border-white/[0.1] transition-all"
            >
              <span>Download Latest</span>
              <span class="text-xs text-slate-400">↗</span>
            </a>
            <a 
              href={levyra.github} 
              target="_blank" 
              rel="noopener noreferrer" 
              class="inline-flex items-center gap-2 px-5 py-3 rounded-full text-slate-300 hover:text-white font-medium text-sm transition-colors"
            >
              <span>Source Code ↗</span>
            </a>
          </div>
        </div>

        <div class="lg:col-span-5 flex flex-col items-center justify-center">
          <div class="relative group w-52 h-52 sm:w-64 sm:h-64 flex items-center justify-center">
            <div class="absolute inset-0 rounded-full bg-gradient-to-tr from-[#38bdf8]/20 via-[#818cf8]/20 to-[#f43f5e]/20 blur-2xl group-hover:scale-110 transition-transform duration-500"></div>
            <img 
              src="/assets/levyra/levyra-logo-3d.png" 
              alt="Levyra DeepSound Logo" 
              class="relative z-10 w-full h-full object-contain drop-shadow-[0_12px_32px_rgba(56,189,248,0.25)] group-hover:scale-105 transition-transform duration-300"
              width="256"
              height="256"
              loading="lazy"
            />
          </div>
        </div>

      </div>
    </div>

  </div>
</section>
