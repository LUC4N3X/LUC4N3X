---
import Button from './Button.astro';

const navItems = [
  { label: 'Projects', href: '/projects' },
  { label: 'Articles', href: '/articles' },
  { label: 'About', href: '/about' },
  { label: 'Contact', href: '/contact' }
];

const currentPath = Astro.url.pathname;
---

<header class="sticky top-0 z-50 w-full border-b border-white/[0.08] bg-[#080b11]/80 backdrop-blur-xl transition-colors">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
    <a href="/" class="flex items-center gap-3 group focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-indigo-500 rounded-2xl p-1">
      <div class="relative w-9 h-9 rounded-xl p-0.5 bg-gradient-to-tr from-[#00F2FE] via-[#38BDF8] to-[#818CF8] shadow-md shadow-sky-500/20 group-hover:scale-105 transition-transform duration-300">
        <div class="w-full h-full rounded-[10px] overflow-hidden bg-[#080b11] flex items-center justify-center">
          <img 
            src="/assets/brand/luc4n3x-mark.svg" 
            alt="LUC4N3X" 
            class="w-full h-full object-contain p-0.5"
            width="36"
            height="36"
          />
        </div>
      </div>
      <div class="flex items-center gap-1.5">
        <span class="font-bold text-sm sm:text-base tracking-wider text-white group-hover:text-[#38bdf8] transition-colors font-mono">
          LUC4N3X
        </span>
        <span class="w-1.5 h-1.5 rounded-full bg-[#38bdf8] animate-pulse"></span>
      </div>
    </a>

    <nav class="hidden md:flex items-center gap-1.5" aria-label="Main Navigation">
      {navItems.map(item => {
        const isActive = currentPath === item.href || (item.href !== '/' && currentPath.startsWith(item.href));
        return (
          <a
            href={item.href}
            class={`px-4 py-1.5 rounded-full text-xs font-medium transition-all duration-200 ${
              isActive 
                ? 'text-white bg-white/[0.1] shadow-sm' 
                : 'text-zinc-400 hover:text-white hover:bg-white/[0.05]'
            }`}
          >
            {item.label}
          </a>
        );
      })}
    </nav>

    <div class="hidden md:flex items-center gap-3">
      <a 
        href="https://github.com/LUC4N3X" 
        target="_blank" 
        rel="noopener noreferrer" 
        class="text-zinc-400 hover:text-white p-2 rounded-full hover:bg-white/[0.06] transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-indigo-500"
        aria-label="GitHub Profile"
      >
        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd" />
        </svg>
      </a>

      <Button href="/projects/levyra" variant="secondary" size="sm">
        <span>Levyra</span>
      </Button>
    </div>

    <button 
      type="button" 
      id="mobile-menu-toggle"
      class="md:hidden text-zinc-400 hover:text-white p-2 rounded-full hover:bg-white/[0.06] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-indigo-500"
      aria-label="Toggle navigation menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <svg id="hamburger-icon" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16m-7 6h7" />
      </svg>
      <svg id="close-icon" class="w-5 h-5 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>

  <div 
    id="mobile-menu" 
    class="hidden md:hidden border-b border-white/[0.08] bg-[#080b11]/95 backdrop-blur-xl px-4 pt-2 pb-6 space-y-2 transition-all"
  >
    {navItems.map(item => {
      const isActive = currentPath === item.href || (item.href !== '/' && currentPath.startsWith(item.href));
      return (
        <a
          href={item.href}
          class={`block px-4 py-2 rounded-full text-sm font-medium transition-colors ${
            isActive 
              ? 'text-white bg-white/[0.1]' 
              : 'text-zinc-400 hover:text-white hover:bg-white/[0.04]'
          }`}
        >
          {item.label}
        </a>
      );
    })}
    <a
      href="/projects/levyra"
      class="block px-4 py-2 rounded-full text-sm font-medium text-[#38bdf8] bg-white/[0.04] border border-white/[0.08]"
    >
      Explore Levyra →
    </a>
    <a
      href="https://github.com/LUC4N3X"
      target="_blank"
      rel="noopener noreferrer"
      class="block px-4 py-2 rounded-full text-sm font-medium text-zinc-400 hover:text-white"
    >
      GitHub Profile ↗
    </a>
  </div>
</header>

<script>
  const toggleBtn = document.getElementById('mobile-menu-toggle');
  const mobileMenu = document.getElementById('mobile-menu');
  const hamburgerIcon = document.getElementById('hamburger-icon');
  const closeIcon = document.getElementById('close-icon');

  if (toggleBtn && mobileMenu && hamburgerIcon && closeIcon) {
    toggleBtn.addEventListener('click', () => {
      const isExpanded = toggleBtn.getAttribute('aria-expanded') === 'true';
      toggleBtn.setAttribute('aria-expanded', (!isExpanded).toString());
      mobileMenu.classList.toggle('hidden');
      hamburgerIcon.classList.toggle('hidden');
      closeIcon.classList.toggle('hidden');
    });
  }
</script>
