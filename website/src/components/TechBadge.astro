---
interface Props {
  text: string;
  variant?: "default" | "cyan" | "muted" | "blue" | "teal";
  size?: "sm" | "md";
}

const { text, variant = "default", size = "sm" } = Astro.props;

const base = "inline-flex items-center font-mono rounded-full border transition-colors";
const sizes = {
  sm: "text-[11px] px-2.5 py-0.5 tracking-wide",
  md: "text-xs px-3 py-1 tracking-wide"
};
const variants = {
  default: "bg-[#1c1916] text-[#a39e94] border-[#2e2a25] hover:text-[#f7f5f2]",
  cyan: "bg-[#34a896]/10 text-[#48c9b0] border-[#34a896]/25",
  blue: "bg-[#34a896]/10 text-[#48c9b0] border-[#34a896]/25",
  teal: "bg-[#34a896]/10 text-[#48c9b0] border-[#34a896]/25",
  muted: "bg-transparent text-[#6e6960] border-[#25221d]"
};
---

<span class={`${base} ${sizes[size]} ${variants[variant]}`}>
  {text}
</span>
