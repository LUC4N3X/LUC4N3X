---
interface Props {
  text: string;
  variant?: "default" | "cyan" | "muted" | "blue";
  size?: "sm" | "md";
}

const { text, variant = "default", size = "sm" } = Astro.props;

const base = "inline-flex items-center font-mono rounded-full border transition-colors";
const sizes = {
  sm: "text-[11px] px-2.5 py-0.5 tracking-wide",
  md: "text-xs px-3 py-1 tracking-wide"
};
const variants = {
  default: "bg-white/[0.06] text-[#86868b] border-white/[0.08] hover:text-[#f5f5f7]",
  cyan: "bg-[#0071e3]/10 text-[#2997ff] border-[#0071e3]/20",
  blue: "bg-[#0071e3]/10 text-[#2997ff] border-[#0071e3]/20",
  muted: "bg-transparent text-[#6e6e73] border-white/[0.05]"
};
---

<span class={`${base} ${sizes[size]} ${variants[variant]}`}>
  {text}
</span>
