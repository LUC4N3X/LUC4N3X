---
interface Props {
  text: string;
  variant?: "default" | "cyan" | "muted" | "blue" | "teal";
  size?: "sm" | "md";
}

const { text, variant = "default", size = "sm" } = Astro.props;

const base = "inline-flex items-center font-mono rounded-full border transition-colors";
const sizes = {
  sm: "text-[11px] px-2.5 py-0.5 tracking-wide",
  md: "text-xs px-3 py-1 tracking-wide"
};
const variants = {
  default: "bg-white/[0.04] text-zinc-300 border-white/[0.08] hover:text-white hover:border-white/[0.15]",
  blue: "bg-[#0071e3]/15 text-[#2997ff] border-[#0071e3]/30",
  cyan: "bg-[#0071e3]/15 text-[#2997ff] border-[#0071e3]/30",
  teal: "bg-[#0071e3]/15 text-[#2997ff] border-[#0071e3]/30",
  muted: "bg-transparent text-zinc-500 border-white/[0.06]"
};
---

<span class={`${base} ${sizes[size]} ${variants[variant]}`}>
  {text}
</span>
