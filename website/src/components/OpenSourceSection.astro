---
import SectionHeader from './SectionHeader.astro';

const rules = [
  {
    title: 'Build the useful thing first',
    body: 'Ship the smallest version that does the job, then live with it for a while. Most of what I thought I needed turns out to be noise.'
  },
  {
    title: 'Run it on real hardware',
    body: 'Emulators never reproduce an OEM battery manager killing a playback service at 2am. The phone in my pocket is the test device.'
  },
  {
    title: 'Fix the smallest real cause',
    body: 'Chase the root, not the symptom. A narrow fix I can verify beats a rewrite I can only hope about.'
  },
  {
    title: 'Keep the data on the device',
    body: 'Listening history lives in Room SQLite on your phone. No account, no telemetry, nothing to opt out of.'
  }
];
---

<section class="py-20 sm:py-28 bg-[#06080d] relative">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16">
      <div class="lg:col-span-5">
        <SectionHeader
          eyebrow="How I build"
          title="Four rules I keep coming back to"
          subtitle="Everything I ship runs on Arch Linux first and on my own phone second. These are the habits that survived."
        />

        <div class="flex flex-wrap gap-2">
          <span class="rounded-full border border-sky-500/25 bg-sky-500/10 px-3 py-1 font-mono text-xs text-[#38bdf8]">Arch Linux</span>
          <span class="rounded-full border border-emerald-500/25 bg-emerald-500/10 px-3 py-1 font-mono text-xs text-[#34d399]">Zero telemetry</span>
          <span class="rounded-full border border-indigo-500/25 bg-indigo-500/10 px-3 py-1 font-mono text-xs text-[#818cf8]">Local-first SQLite</span>
          <span class="rounded-full border border-rose-500/25 bg-rose-500/10 px-3 py-1 font-mono text-xs text-[#f43f5e]">GPL-3.0</span>
        </div>
      </div>

      <ol class="lg:col-span-7 grid grid-cols-1 sm:grid-cols-2 gap-px rounded-2xl overflow-hidden bg-white/[0.07]">
        {rules.map((rule, i) => (
          <li class="spotlight bg-[#0a0e18] p-6 sm:p-7">
            <span class="font-mono text-xs text-[#7f9bc4]">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="mt-3 text-lg font-semibold text-white tracking-tight">{rule.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-zinc-400">{rule.body}</p>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>
