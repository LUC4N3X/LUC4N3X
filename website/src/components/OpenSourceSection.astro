---
import SectionHeader from './SectionHeader.astro';
---

<section class="py-20 sm:py-28 border-t border-white/[0.08] bg-black relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <SectionHeader
      eyebrow="Distribution & Verification"
      title="Reproducible builds and independent audits"
      subtitle="Levyra is built from public source, checked by independent security scanners, and distributed across open-source app stores."
      align="center"
    />

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
      <a 
        href="https://f-droid.org/packages/com.luc4n3x.levyra/"
        target="_blank"
        rel="noopener noreferrer"
        class="group p-7 rounded-2xl bg-[#0c0c0e] border border-white/[0.08] hover:border-white/[0.18] transition-all flex flex-col justify-between"
      >
        <div>
          <div class="flex items-center justify-between mb-4">
            <span class="text-[11px] font-mono uppercase tracking-wider text-[#2997ff]">F-Droid Official</span>
            <span class="text-zinc-600 group-hover:text-white transition-colors text-xs">↗</span>
          </div>
          <h3 class="text-lg font-semibold text-white mb-2 tracking-tight">Reproducible Builds</h3>
          <p class="text-xs text-zinc-400 leading-relaxed">
            Compiled directly from source on F-Droid build servers with no proprietary blobs or tracking libraries.
          </p>
        </div>
        <div class="mt-6 pt-4 border-t border-white/[0.08] text-[11px] font-mono text-zinc-500">
          com.luc4n3x.levyra
        </div>
      </a>

      <a 
        href="https://apptizo.com/app/levyra/"
        target="_blank"
        rel="noopener noreferrer"
        class="group p-7 rounded-2xl bg-[#0c0c0e] border border-white/[0.08] hover:border-white/[0.18] transition-all flex flex-col justify-between"
      >
        <div>
          <div class="flex items-center justify-between mb-4">
            <span class="text-[11px] font-mono uppercase tracking-wider text-emerald-400">Apptizo Audit</span>
            <span class="text-zinc-600 group-hover:text-white transition-colors text-xs">↗</span>
          </div>
          <h3 class="text-lg font-semibold text-white mb-2 tracking-tight">0 Trackers · 0 Ads</h3>
          <p class="text-xs text-zinc-400 leading-relaxed">
            Independent static APK audit confirming 0 tracking SDKs, 0 advertising libraries, and 5 minimal Android permissions.
          </p>
        </div>
        <div class="mt-6 pt-4 border-t border-white/[0.08] text-[11px] font-mono text-zinc-500">
          apptizo.com/app/levyra
        </div>
      </a>

      <a 
        href="https://apt.izzysoft.de/fdroid/index/apk/com.luc4n3x.levyra"
        target="_blank"
        rel="noopener noreferrer"
        class="group p-7 rounded-2xl bg-[#0c0c0e] border border-white/[0.08] hover:border-white/[0.18] transition-all flex flex-col justify-between"
      >
        <div>
          <div class="flex items-center justify-between mb-4">
            <span class="text-[11px] font-mono uppercase tracking-wider text-[#2997ff]">IzzyOnDroid</span>
            <span class="text-zinc-600 group-hover:text-white transition-colors text-xs">↗</span>
          </div>
          <h3 class="text-lg font-semibold text-white mb-2 tracking-tight">Fast Repository</h3>
          <p class="text-xs text-zinc-400 leading-relaxed">
            Listed in the IzzyOnDroid F-Droid repository with automated scanner checks on every release APK.
          </p>
        </div>
        <div class="mt-6 pt-4 border-t border-white/[0.08] text-[11px] font-mono text-zinc-500">
          apt.izzysoft.de
        </div>
      </a>

      <a 
        href="https://hosted.weblate.org/engage/levyra/"
        target="_blank"
        rel="noopener noreferrer"
        class="group p-7 rounded-2xl bg-[#0c0c0e] border border-white/[0.08] hover:border-white/[0.18] transition-all flex flex-col justify-between"
      >
        <div>
          <div class="flex items-center justify-between mb-4">
            <span class="text-[11px] font-mono uppercase tracking-wider text-[#2997ff]">Hosted Weblate</span>
            <span class="text-zinc-600 group-hover:text-white transition-colors text-xs">↗</span>
          </div>
          <h3 class="text-lg font-semibold text-white mb-2 tracking-tight">37 Languages</h3>
          <p class="text-xs text-zinc-400 leading-relaxed">
            Community-maintained localization with 100% Android translation coverage across 37 languages.
          </p>
        </div>
        <div class="mt-6 pt-4 border-t border-white/[0.08] text-[11px] font-mono text-zinc-500">
          hosted.weblate.org
        </div>
      </a>
    </div>
  </div>
</section>
