---
import SectionHeader from './SectionHeader.astro';
import { techDomains } from '../data/skills';
import TechBadge from './TechBadge.astro';
---

<section class="py-20 sm:py-28 border-t border-[#24211d] bg-[#0e0d0c] relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <SectionHeader
      eyebrow="Open Source & Architecture"
      title="Engineering Without Compromise"
      subtitle="Software engineered with respect for user autonomy, device efficiency, and long-term maintainability. Zero telemetry, no dark patterns, and transparent architecture."
    />

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-stretch mb-16">
      <div class="lg:col-span-7 flex flex-col justify-between gap-6">
        <div class="p-8 rounded-3xl bg-[#171513] border border-[#27231e]">
          <h3 class="text-2xl font-semibold text-[#f7f5f2] mb-3">
            The Contribution Philosophy
          </h3>
          <p class="text-[#a39e94] text-base sm:text-lg leading-relaxed mb-6 font-normal">
            Build the useful thing first. Run it on real hardware. Find what breaks. Fix the smallest real cause, and keep working on it until it feels right.
          </p>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-xs font-mono text-[#a39e94]">
            <div class="flex items-center gap-2">
              <span class="w-1.5 h-1.5 rounded-full bg-[#34a896]"></span>
              <span>No user tracking or telemetry</span>
            </div>
            <div class="flex items-center gap-2">
              <span class="w-1.5 h-1.5 rounded-full bg-[#34a896]"></span>
              <span>Local-first data persistence</span>
            </div>
            <div class="flex items-center gap-2">
              <span class="w-1.5 h-1.5 rounded-full bg-[#34a896]"></span>
              <span>Direct service connections</span>
            </div>
            <div class="flex items-center gap-2">
              <span class="w-1.5 h-1.5 rounded-full bg-[#34a896]"></span>
              <span>GNU GPL v3 & open licensing</span>
            </div>
          </div>
        </div>

        <div class="p-8 rounded-3xl bg-[#171513] border border-[#27231e]">
          <h3 class="text-2xl font-semibold text-[#f7f5f2] mb-3">
            Community Translations
          </h3>
          <p class="text-[#a39e94] text-sm sm:text-base leading-relaxed mb-4 font-normal">
            Levyra and related software are localized by community contributors worldwide through Weblate across 36 languages.
          </p>
          <a 
            href="https://hosted.weblate.org/engage/levyra/" 
            target="_blank" 
            rel="noopener noreferrer" 
            class="inline-flex items-center gap-2 text-xs font-mono text-[#34a896] hover:underline font-medium"
          >
            <span>Contribute on Weblate</span>
            <span>→</span>
          </a>
        </div>
      </div>

      <div class="lg:col-span-5 flex items-center justify-center p-6 rounded-3xl bg-[#171513] border border-[#27231e]">
        <div class="relative w-full max-w-sm rounded-2xl overflow-hidden p-4">
          <img 
            src="/assets/brand/luc4n3x-linux-stack.svg" 
            alt="Linux & Android Tech Stack" 
            class="w-full h-auto object-contain"
            loading="lazy"
            width="340"
            height="340"
          />
        </div>
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
      {techDomains.map(domain => (
        <div class="rounded-3xl border border-[#27231e] bg-[#171513] p-6 flex flex-col justify-between">
          <div>
            <span class="text-xs font-mono uppercase tracking-widest text-[#34a896] font-semibold mb-2 block">
              {domain.category}
            </span>
            <h4 class="text-lg font-semibold text-[#f7f5f2] mb-2">
              {domain.title}
            </h4>
            <p class="text-xs text-[#a39e94] leading-relaxed mb-6 font-normal">
              {domain.description}
            </p>
          </div>
          <div class="flex flex-wrap gap-1">
            {domain.technologies.map(tech => (
              <TechBadge text={tech} size="sm" />
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
