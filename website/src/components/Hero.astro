---
import Button from './Button.astro';
import { siteConfig } from '../data/site';
---

<section class="relative min-h-[90vh] flex items-center justify-center overflow-hidden pt-16 pb-20 sm:py-24 bg-[#0e0d0c] bg-architect-grid">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative w-full">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-center">
      <div class="lg:col-span-7 flex flex-col items-start text-left">
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full border border-[#2e2a25] bg-[#1a1815] mb-6 text-xs font-mono text-[#a39e94]">
          <span class="w-1.5 h-1.5 rounded-full bg-[#34a896]"></span>
          <span class="text-[#f7f5f2] font-semibold tracking-wider">LUC4N3X</span>
          <span class="text-[#44403a]">/</span>
          <span>SYSTEMS & MOBILE CRAFT</span>
        </div>

        <h1 class="text-5xl sm:text-6xl md:text-7xl lg:text-8xl font-semibold tracking-tight text-[#f7f5f2] mb-4 select-none">
          LUC4N3X
        </h1>

        <p class="text-xl sm:text-2xl font-medium text-[#f7f5f2] tracking-tight mb-4 max-w-2xl leading-snug">
          Open-Source Media Engines, Resilient Gateways & Low-Latency Android Architecture.
        </p>

        <p class="text-[#a39e94] text-base sm:text-lg max-w-xl font-normal leading-relaxed mb-8">
          Independent software craftsman building zero-telemetry Android applications, media streaming pipelines, and local-first systems designed for real hardware.
        </p>

        <div class="flex flex-wrap items-center gap-3 sm:gap-4 mb-10 w-full">
          <Button href="/projects" variant="primary" size="lg">
            <span>Explore Projects</span>
            <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </Button>

          <Button href={siteConfig.github} target="_blank" variant="secondary" size="lg">
            <svg class="w-4 h-4 text-[#a39e94]" fill="currentColor" viewBox="0 0 24 24">
              <path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd" />
            </svg>
            <span>GitHub</span>
          </Button>

          <Button href="/projects/levyra" variant="outline" size="lg">
            <span>Levyra</span>
            <span data-levyra-version class="text-xs font-mono px-2 py-0.5 rounded-full bg-[#34a896]/15 text-[#48c9b0] border border-[#34a896]/30 hidden"></span>
          </Button>
        </div>

        <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 pt-6 border-t border-[#26221d] w-full text-xs font-mono">
          <div>
            <span class="text-[#736e65] block mb-1">Stars & Community</span>
            <span class="font-semibold text-[#f7f5f2] text-sm">380+ Stars</span>
          </div>
          <div>
            <span class="text-[#736e65] block mb-1">Direct Downloads</span>
            <span class="font-semibold text-[#f7f5f2] text-sm">6k+ Distributed</span>
          </div>
          <div>
            <span class="text-[#736e65] block mb-1">Architecture</span>
            <span class="font-semibold text-[#f7f5f2] text-sm">Media3 / Jetpack</span>
          </div>
          <div>
            <span class="text-[#736e65] block mb-1">Privacy Guarantee</span>
            <span class="font-semibold text-[#34a896] text-sm">Zero Telemetry</span>
          </div>
        </div>
      </div>

      <div class="lg:col-span-5 flex flex-col justify-center">
        <div class="rounded-3xl border border-[#2e2a24] bg-[#141210] p-6 sm:p-7 shadow-2xl relative overflow-hidden">
          <div class="flex items-center justify-between pb-4 mb-6 border-b border-[#26221d]">
            <div class="flex items-center gap-2">
              <span class="w-2.5 h-2.5 rounded-full bg-[#34a896]"></span>
              <span class="text-xs font-mono text-[#f7f5f2] font-semibold tracking-wide">
                ENGINE RUNTIME HUD
              </span>
            </div>
            <span class="text-[11px] font-mono px-2.5 py-0.5 rounded-full bg-[#1c1916] text-[#a39e94] border border-[#2e2a25]">
              androidx.media3
            </span>
          </div>

          <div class="mb-6 p-4 rounded-2xl bg-[#0e0d0c] border border-[#24201a]">
            <div class="flex items-center justify-between text-xs font-mono mb-3">
              <span class="text-[#736e65]">Audio Stream Spectrum</span>
              <span class="text-[#48c9b0] font-semibold">Lossless AudioTrack</span>
            </div>
            <div class="h-16 flex items-end justify-between gap-1 sm:gap-1.5 px-1 py-1">
              <div class="w-full bg-[#34a896] rounded-t-sm animate-pulse h-8"></div>
              <div class="w-full bg-[#34a896]/90 rounded-t-sm animate-pulse h-12"></div>
              <div class="w-full bg-[#34a896]/80 rounded-t-sm animate-pulse h-6"></div>
              <div class="w-full bg-[#f7f5f2] rounded-t-sm animate-pulse h-14"></div>
              <div class="w-full bg-[#f7f5f2] rounded-t-sm animate-pulse h-10"></div>
              <div class="w-full bg-[#34a896] rounded-t-sm animate-pulse h-16"></div>
              <div class="w-full bg-[#34a896]/80 rounded-t-sm animate-pulse h-9"></div>
              <div class="w-full bg-[#f7f5f2] rounded-t-sm animate-pulse h-13"></div>
              <div class="w-full bg-[#34a896] rounded-t-sm animate-pulse h-15"></div>
              <div class="w-full bg-[#34a896]/90 rounded-t-sm animate-pulse h-7"></div>
              <div class="w-full bg-[#f7f5f2] rounded-t-sm animate-pulse h-11"></div>
              <div class="w-full bg-[#34a896] rounded-t-sm animate-pulse h-14"></div>
              <div class="w-full bg-[#34a896]/80 rounded-t-sm animate-pulse h-8"></div>
              <div class="w-full bg-[#f7f5f2] rounded-t-sm animate-pulse h-12"></div>
              <div class="w-full bg-[#34a896] rounded-t-sm animate-pulse h-10"></div>
              <div class="w-full bg-[#34a896]/90 rounded-t-sm animate-pulse h-6"></div>
            </div>
          </div>

          <div class="space-y-3 mb-6">
            <div class="flex items-center justify-between p-3 rounded-xl bg-[#1c1916] border border-[#27231e] text-xs font-mono">
              <span class="text-[#a39e94]">1. Stream Source</span>
              <span class="text-[#f7f5f2] font-semibold">Direct CDN via TLS 1.3</span>
            </div>
            <div class="flex items-center justify-between p-3 rounded-xl bg-[#1c1916] border border-[#27231e] text-xs font-mono">
              <span class="text-[#a39e94]">2. Buffer Engine</span>
              <span class="text-[#f7f5f2] font-semibold">ExoPlayer Adaptive Ring Buffer</span>
            </div>
            <div class="flex items-center justify-between p-3 rounded-xl bg-[#1c1916] border border-[#27231e] text-xs font-mono">
              <span class="text-[#a39e94]">3. Audio Session</span>
              <span class="text-[#f7f5f2] font-semibold">Gapless Foreground MediaSession</span>
            </div>
          </div>

          <div class="grid grid-cols-2 gap-3 text-xs font-mono pt-4 border-t border-[#26221d]">
            <div class="p-3 rounded-xl bg-[#0e0d0c] border border-[#24201a]">
              <span class="text-[#736e65] block mb-1">Telemetry</span>
              <span class="text-[#34a896] font-semibold">0.0 KB · Blocked</span>
            </div>
            <div class="p-3 rounded-xl bg-[#0e0d0c] border border-[#24201a]">
              <span class="text-[#736e65] block mb-1">Database</span>
              <span class="text-[#f7f5f2] font-semibold">Room SQLite Local</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
