---
import Button from './Button.astro';
import { siteConfig } from '../data/site';
---

<section class="relative min-h-[85vh] flex items-center justify-center overflow-hidden pt-20 pb-20 sm:pt-28 sm:pb-24 bg-[#000000] bg-apple-glow">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 relative w-full text-center flex flex-col items-center">
    <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full border border-white/[0.08] bg-white/[0.04] mb-8 text-xs font-mono text-zinc-400">
      <span class="w-1.5 h-1.5 rounded-full bg-[#2997ff]"></span>
      <span class="text-white font-medium tracking-wide">LUC4N3X</span>
      <span class="text-zinc-600">/</span>
      <span>INDEPENDENT SOFTWARE CRAFTSMAN</span>
    </div>

    <h1 class="text-4xl sm:text-6xl md:text-7xl font-semibold tracking-tight text-white mb-6 max-w-4xl leading-[1.08]">
      Software engineered for real devices.
    </h1>

    <p class="text-lg sm:text-2xl text-zinc-300 font-normal tracking-tight mb-4 max-w-3xl leading-relaxed">
      High-performance Android architecture, low-latency audio pipelines, and zero-telemetry open source software.
    </p>

    <p class="text-sm sm:text-base text-zinc-400 max-w-2xl font-normal leading-relaxed mb-10">
      Hey, I'm Luca. I design and build software that runs cleanly on real hardware. Focused on solving root causes, optimizing local on-device storage, and crafting tools that respect user sovereignty.
    </p>

    <div class="flex flex-wrap items-center justify-center gap-3 sm:gap-4 mb-16">
      <Button href="/projects" variant="primary" size="lg">
        <span>Explore Projects</span>
        <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      </Button>

      <Button href="/articles" variant="secondary" size="lg">
        <span>Read Articles</span>
        <span class="ml-1 text-xs font-mono text-[#2997ff]">4 Notes</span>
      </Button>

      <Button href={siteConfig.github} target="_blank" variant="outline" size="lg">
        <svg class="w-4 h-4 text-zinc-400" fill="currentColor" viewBox="0 0 24 24">
          <path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd" />
        </svg>
        <span>GitHub</span>
      </Button>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-5 w-full text-left">
      <div class="p-6 rounded-2xl border border-white/[0.08] bg-[#0c0c0e] hover:border-white/[0.16] transition-colors">
        <span class="text-xs font-mono text-[#2997ff] block mb-2 font-medium">01 · PLATFORM & CORE</span>
        <h3 class="text-base font-semibold text-white mb-2">Android & Systems</h3>
        <p class="text-xs text-zinc-400 leading-relaxed font-normal">
          Native Kotlin, AndroidX Media3 streaming lifecycles, adaptive ExoPlayer buffering, and declarative Jetpack Compose UI.
        </p>
      </div>

      <div class="p-6 rounded-2xl border border-white/[0.08] bg-[#0c0c0e] hover:border-white/[0.16] transition-colors">
        <span class="text-xs font-mono text-[#2997ff] block mb-2 font-medium">02 · ARCHITECTURE</span>
        <h3 class="text-base font-semibold text-white mb-2">Zero Telemetry</h3>
        <p class="text-xs text-zinc-400 leading-relaxed font-normal">
          On-device Room SQLite persistence by default. Direct TLS 1.3 streams without third-party tracker SDKs or telemetry proxies.
        </p>
      </div>

      <div class="p-6 rounded-2xl border border-white/[0.08] bg-[#0c0c0e] hover:border-white/[0.16] transition-colors">
        <span class="text-xs font-mono text-[#2997ff] block mb-2 font-medium">03 · PHILOSOPHY</span>
        <h3 class="text-base font-semibold text-white mb-2">Pragmatic Craft</h3>
        <p class="text-xs text-zinc-400 leading-relaxed font-normal">
          Root-cause isolation before any code change. Surgical, evidence-backed diffs preferred over unvetted architectural rewrites.
        </p>
      </div>
    </div>
  </div>
</section>
