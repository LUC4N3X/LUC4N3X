---
import Button from './Button.astro';
import { siteConfig } from '../data/site';
---

<section class="relative min-h-[82vh] flex items-center justify-center overflow-hidden pt-16 pb-20 sm:pt-24 sm:pb-28 bg-[#080b11] bg-ambient-glow">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 relative w-full text-center flex flex-col items-center">
    
    <div class="relative mb-8 group">
      <div class="w-24 h-24 sm:w-28 sm:h-28 rounded-full p-1 bg-gradient-to-tr from-[#38bdf8] via-[#818cf8] to-[#f43f5e] shadow-xl shadow-indigo-500/25 transition-transform duration-500 group-hover:scale-105">
        <div class="w-full h-full rounded-full overflow-hidden bg-[#0e131f]">
          <img 
            src="/assets/brand/luc4n3x-avatar.png" 
            alt="Luca Drogo (LUC4N3X)" 
            class="w-full h-full object-cover"
            width="112"
            height="112"
            loading="eager"
          />
        </div>
      </div>
      <div class="absolute -bottom-2.5 left-1/2 -translate-x-1/2 px-3 py-0.5 rounded-full bg-[#0e131f] border border-white/[0.14] text-[11px] font-mono text-zinc-300 shadow-lg whitespace-nowrap flex items-center gap-1.5">
        <span class="w-1.5 h-1.5 rounded-full bg-[#10b981] animate-pulse"></span>
        <span>Independent Craftsman</span>
      </div>
    </div>

    <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full border border-white/[0.08] bg-white/[0.03] mb-6 text-xs font-mono text-zinc-400 backdrop-blur-md">
      <span class="text-white font-medium">Luca Drogo</span>
      <span class="text-zinc-600">/</span>
      <span class="text-[#38bdf8]">@LUC4N3X</span>
    </div>

    <h1 class="text-4xl sm:text-5xl md:text-6xl font-semibold tracking-tight text-white max-w-3xl leading-[1.15] mb-6">
      Crafting high-performance audio engines & <span class="bg-clip-text text-transparent bg-gradient-to-r from-[#38bdf8] via-[#818cf8] to-[#f43f5e]">zero-telemetry software</span>.
    </h1>

    <p class="text-base sm:text-lg md:text-xl text-zinc-300 max-w-2xl font-normal leading-relaxed mb-8">
      Hey, I'm Luca. I design and engineer native Android applications, low-latency audio pipelines, and developer tooling. Built with precision for real hardware, with zero trackers, zero ads, and complete user privacy.
    </p>

    <div class="flex flex-wrap items-center justify-center gap-3 sm:gap-4 mb-14">
      <Button href="/projects/levyra" variant="primary" size="lg">
        <span>Explore Levyra</span>
        <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      </Button>

      <Button href="/articles" variant="secondary" size="lg">
        <span>Read Engineering Notes</span>
        <span class="ml-1 text-xs font-mono text-[#38bdf8]">4 Notes</span>
      </Button>

      <Button href={siteConfig.github} target="_blank" variant="outline" size="lg">
        <svg class="w-4 h-4 text-zinc-400" fill="currentColor" viewBox="0 0 24 24">
          <path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd" />
        </svg>
        <span>GitHub</span>
      </Button>
    </div>

    <div class="flex flex-wrap items-center justify-center gap-2 max-w-xl text-xs font-mono text-zinc-400">
      <span class="px-3 py-1 rounded-full bg-white/[0.04] border border-white/[0.08]">AndroidX Media3</span>
      <span class="px-3 py-1 rounded-full bg-white/[0.04] border border-white/[0.08]">Jetpack Compose</span>
      <span class="px-3 py-1 rounded-full bg-white/[0.04] border border-white/[0.08]">ExoPlayer Buffering</span>
      <span class="px-3 py-1 rounded-full bg-white/[0.04] border border-white/[0.08]">On-Device SQLite</span>
      <span class="px-3 py-1 rounded-full bg-white/[0.04] border border-white/[0.08]">Zero Telemetry</span>
      <span class="px-3 py-1 rounded-full bg-white/[0.04] border border-white/[0.08]">Linux & Systems</span>
    </div>

  </div>
</section>
