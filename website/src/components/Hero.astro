        <path d="M48 70C36.9543 70 28 61.0457 28 50C28 39.5694 36.0028 30.9858 46.208 30.1042C50.5902 20.7303 60.0384 14.1667 71 14.1667C78.2327 14.1667 84.757 17.5147 89.0435 22.7538C93.308 19.6415 98.6015 17.7083 104.333 17.7083C117.514 17.7083 128.271 27.608 130.081 40.3756C133.298 38.4388 137.054 37.3333 141.083 37.3333C152.359 37.3333 161.5 46.4741 161.5 57.75C161.5 58.5997 161.448 59.4371 161.347 60.2598C166.368 61.7067 170.062 66.334 170.062 71.825C170.062 78.6053 164.568 84.1 157.788 84.1H48V70Z" fill="#e0f2fe" fill-opacity="0.35" />
      </svg>
    </div>

    <div class="absolute top-28 -right-16 sm:right-8 w-48 sm:w-80 h-28 sm:h-36 opacity-35 animate-cloud-drift-mid">
      <svg viewBox="0 0 260 110" fill="none" class="w-full h-full filter drop-shadow-[0_16px_32px_rgba(129,140,248,0.18)]">
        <path d="M50 85C33.4315 85 20 71.5685 20 55C20 39.4808 31.7828 26.7111 46.9092 25.1716C53.4132 11.4191 67.391 1.875 83.6 1.875C94.2048 1.875 103.728 6.74415 110.055 14.3976C116.332 9.82584 124.122 7.01875 132.56 7.01875C151.962 7.01875 167.854 21.5348 170.514 40.2557C175.256 37.4273 180.783 35.8187 186.68 35.8187C203.249 35.8187 216.68 49.2502 216.68 65.8187C216.68 67.065 216.603 68.293 216.454 69.499C223.846 71.6206 229.28 78.4052 229.28 86.46C229.28 96.4011 221.221 104.46 211.28 104.46H50V85Z" fill="#818cf8" fill-opacity="0.25" />
