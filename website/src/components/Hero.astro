---
import Button from './Button.astro';
import Clouds from './Clouds.astro';
import CloudDivider from './CloudDivider.astro';
import { siteConfig } from '../data/site';
---

<section class="relative min-h-[95vh] flex flex-col justify-between overflow-hidden pt-24 sm:pt-32 bg-gradient-to-b from-[#091326] via-[#0d1d3a] to-[#080b11]">
  
  <div class="absolute inset-0 overflow-hidden pointer-events-none -z-0">
    <div class="absolute -top-32 left-1/2 -translate-x-1/2 w-[800px] sm:w-[1100px] h-[550px] bg-gradient-to-b from-sky-500/20 via-indigo-500/15 to-transparent rounded-full blur-[140px]"></div>
    <div class="absolute top-1/4 left-10 w-96 h-64 bg-sky-400/15 rounded-full blur-[100px]"></div>
    <div class="absolute top-1/3 right-10 w-[420px] h-72 bg-purple-500/15 rounded-full blur-[120px]"></div>
    <div class="absolute bottom-1/3 left-1/2 -translate-x-1/2 w-[600px] h-48 bg-cyan-400/10 rounded-full blur-[90px]"></div>

    <Clouds variant="field" />
  </div>

  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 relative w-full text-center flex flex-col items-center z-10 my-auto pb-10 sm:pb-16">
    
    <div class="relative mb-6 sm:mb-8 group">
      <div class="absolute -inset-4 bg-gradient-to-r from-sky-500/25 via-indigo-500/20 to-purple-500/20 rounded-full blur-2xl opacity-75 group-hover:opacity-100 transition-opacity duration-500 pointer-events-none"></div>

      <div class="relative w-28 h-28 sm:w-36 sm:h-36 rounded-full p-1 ring-1 ring-white/15 shadow-2xl shadow-sky-500/20 transition-transform duration-500 group-hover:scale-105 bg-gradient-to-b from-white/10 to-white/5 backdrop-blur-md">
        <div class="w-full h-full rounded-full overflow-hidden bg-[#070a14] p-0.5">
          <img 
            src="/assets/brand/luc4n3x-avatar.png" 
            alt="LUC4N3X" 
            class="w-full h-full object-cover rounded-full"
            width="144"
            height="144"
            loading="eager"
          />
        </div>
      </div>
    </div>

    <h1 class="text-3xl sm:text-5xl md:text-6xl lg:text-7xl font-extrabold tracking-[-0.03em] text-white max-w-5xl leading-[1.12] mb-6">
      Building native audio players & <span class="bg-clip-text text-transparent bg-gradient-to-r from-[#38bdf8] via-[#818cf8] to-[#c084fc]">zero-telemetry software</span>.
    </h1>

    <p class="text-base sm:text-lg md:text-xl text-zinc-300 max-w-2xl font-normal leading-relaxed mb-8 sm:mb-10 px-2 sm:px-0">
      I build software I want to use, and keep working on it until it feels right. Native Android and Windows apps, audio pipelines, and Linux CLI tools with no trackers, no ads, and no accounts.
    </p>

    <div class="flex flex-col sm:flex-row items-stretch sm:items-center justify-center gap-3 sm:gap-4 mb-10 sm:mb-12 w-full sm:w-auto max-w-sm sm:max-w-none">
      <Button href="/projects/levyra" variant="primary" size="lg" class="w-full sm:w-auto">
        <span>Explore Levyra</span>
        <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      </Button>

      <Button href="/articles" variant="secondary" size="lg" class="w-full sm:w-auto">
        <span>Read Engineering Notes</span>
      </Button>

      <Button href={siteConfig.github} target="_blank" variant="outline" size="lg" class="w-full sm:w-auto">
        <svg class="w-4 h-4 text-zinc-400" fill="currentColor" viewBox="0 0 24 24">
          <path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd" />
        </svg>
        <span>GitHub</span>
      </Button>
    </div>

    <div class="flex flex-wrap items-center justify-center gap-1.5 sm:gap-2 max-w-2xl text-[11px] sm:text-xs font-mono">
      <span class="inline-flex items-center gap-1.5 px-3 py-1 sm:px-3.5 sm:py-1.5 rounded-full bg-white/[0.04] border border-white/[0.08] text-zinc-300">
        <span class="w-1.5 h-1.5 rounded-full bg-[#38bdf8]"></span>
        <span>Arch Linux</span>
      </span>
      <span class="inline-flex items-center gap-1.5 px-3 py-1 sm:px-3.5 sm:py-1.5 rounded-full bg-white/[0.04] border border-white/[0.08] text-zinc-300">
        <span class="w-1.5 h-1.5 rounded-full bg-[#818cf8]"></span>
        <span>AndroidX Media3</span>
      </span>
      <span class="inline-flex items-center gap-1.5 px-3 py-1 sm:px-3.5 sm:py-1.5 rounded-full bg-white/[0.04] border border-white/[0.08] text-zinc-300">
        <span class="w-1.5 h-1.5 rounded-full bg-[#38bdf8]"></span>
        <span>Jetpack Compose</span>
      </span>
      <span class="inline-flex items-center gap-1.5 px-3 py-1 sm:px-3.5 sm:py-1.5 rounded-full bg-white/[0.04] border border-white/[0.08] text-zinc-300">
        <span class="w-1.5 h-1.5 rounded-full bg-[#34d399]"></span>
        <span>Zero Telemetry</span>
      </span>
      <span class="inline-flex items-center gap-1.5 px-3 py-1 sm:px-3.5 sm:py-1.5 rounded-full bg-white/[0.04] border border-white/[0.08] text-zinc-300">
        <span class="w-1.5 h-1.5 rounded-full bg-[#c084fc]"></span>
        <span>On-Device SQLite</span>
      </span>
    </div>

  </div>

  <CloudDivider fill="#080b11" />
</section>
