---
import Button from './Button.astro';
import { siteConfig } from '../data/site';
---

<section class="relative min-h-[85vh] flex items-center justify-center overflow-hidden pt-16 pb-20 sm:py-28 bg-[#0e0d0c]">
  <div class="relative max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center flex flex-col items-center">
    <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full border border-[#2e2a25] bg-[#1a1815] mb-8 text-xs font-mono text-[#a39e94]">
      <span class="text-[#f7f5f2] font-semibold tracking-wider">LUC4N3X</span>
      <span class="text-[#44403a]">/</span>
      <span>SYSTEMS</span>
      <span class="text-[#44403a]">/</span>
      <span>OPEN SOURCE</span>
    </div>

    <h1 class="text-6xl sm:text-7xl md:text-8xl lg:text-9xl font-semibold tracking-tight text-[#f7f5f2] mb-6 select-none">
      LUC4N3X
    </h1>

    <p class="text-xl sm:text-2xl md:text-3xl font-medium text-[#f7f5f2] tracking-tight mb-4 max-w-3xl">
      {siteConfig.tagline}
    </p>

    <p class="text-[#a39e94] text-base sm:text-lg md:text-xl max-w-2xl font-normal leading-relaxed mb-10">
      {siteConfig.motto}
    </p>

    <div class="flex flex-wrap items-center justify-center gap-3 sm:gap-4 mb-14">
      <Button href="/projects" variant="primary" size="lg">
        <span>View Projects</span>
        <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      </Button>

      <Button href={siteConfig.github} target="_blank" variant="secondary" size="lg">
        <svg class="w-4 h-4 text-[#a39e94]" fill="currentColor" viewBox="0 0 24 24">
          <path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd" />
        </svg>
        <span>GitHub</span>
      </Button>

      <Button href="/projects/levyra" variant="outline" size="lg">
        <span>Explore Levyra</span>
        <span data-levyra-version class="text-xs font-mono px-2 py-0.5 rounded-full bg-[#34a896]/15 text-[#48c9b0] border border-[#34a896]/30 hidden"></span>
      </Button>
    </div>

    <div class="flex flex-wrap items-center justify-center gap-2 sm:gap-3 text-xs font-mono text-[#a39e94]">
      <span>Android & Kotlin</span>
      <span class="text-[#44403a]">·</span>
      <span>Jetpack Compose</span>
      <span class="text-[#44403a]">·</span>
      <span>AndroidX Media3</span>
      <span class="text-[#44403a]">·</span>
      <span>Python & APIs</span>
      <span class="text-[#44403a]">·</span>
      <span>Docker & Linux</span>
    </div>
  </div>
</section>
