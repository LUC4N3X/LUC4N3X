---
interface Props {
  href?: string;
  variant?: "primary" | "secondary" | "outline" | "ghost";
  size?: "sm" | "md" | "lg";
  class?: string;
  target?: string;
  rel?: string;
  type?: "button" | "submit" | "reset";
  ariaLabel?: string;
}

const {
  href,
  variant = "primary",
  size = "md",
  class: className = "",
  target,
  rel = target === "_blank" ? "noopener noreferrer" : undefined,
  type = "button",
  ariaLabel
} = Astro.props;

const baseStyles = "inline-flex items-center justify-center font-medium rounded-full transition-all duration-200 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#2997ff] focus-visible:ring-offset-2 focus-visible:ring-offset-black disabled:opacity-50 disabled:pointer-events-none active:scale-[0.97]";

const sizeStyles = {
  sm: "text-xs px-3.5 py-1.5 gap-1.5",
  md: "text-sm px-5 py-2 gap-2",
  lg: "text-base px-6 py-2.5 gap-2.5"
};

const variantStyles = {
  primary: "bg-[#0071e3] text-white hover:bg-[#0077ed] shadow-sm shadow-[#0071e3]/20",
  secondary: "bg-white/[0.08] text-white border border-white/[0.1] hover:bg-white/[0.14] hover:border-white/[0.2]",
  outline: "bg-transparent text-white border border-white/[0.15] hover:border-white/[0.3] hover:bg-white/[0.06]",
  ghost: "bg-transparent text-zinc-400 hover:text-white hover:bg-white/[0.06]"
};

const combinedClasses = `${baseStyles} ${sizeStyles[size]} ${variantStyles[variant]} ${className}`;
---

{
  href ? (
    <a href={href} class={combinedClasses} target={target} rel={rel} aria-label={ariaLabel}>
      <slot />
    </a>
  ) : (
    <button type={type} class={combinedClasses} aria-label={ariaLabel}>
      <slot />
    </button>
  )
}
