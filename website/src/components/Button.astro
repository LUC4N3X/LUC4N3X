---
interface Props {
  href?: string;
  variant?: "primary" | "secondary" | "outline" | "ghost";
  size?: "sm" | "md" | "lg";
  class?: string;
  target?: string;
  rel?: string;
  type?: "button" | "submit" | "reset";
  ariaLabel?: string;
}

const {
  href,
  variant = "primary",
  size = "md",
  class: className = "",
  target,
  rel = target === "_blank" ? "noopener noreferrer" : undefined,
  type = "button",
  ariaLabel
} = Astro.props;

const baseStyles = "inline-flex items-center justify-center font-medium rounded-full transition-all duration-200 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#34a896] focus-visible:ring-offset-2 focus-visible:ring-offset-[#0e0d0c] disabled:opacity-50 disabled:pointer-events-none active:scale-[0.98]";

const sizeStyles = {
  sm: "text-xs px-3.5 py-1.5 gap-1.5",
  md: "text-sm px-5 py-2 gap-2",
  lg: "text-base px-6 py-3 gap-2.5"
};

const variantStyles = {
  primary: "bg-[#f7f5f2] text-[#0e0d0c] hover:bg-[#eae6df]",
  secondary: "bg-[#1c1916] text-[#f7f5f2] border border-[#302c27] hover:bg-[#25221e]",
  outline: "bg-transparent text-[#f7f5f2] border border-[#38332d] hover:border-[#4d463d] hover:bg-[#1a1815]",
  ghost: "bg-transparent text-[#a39e94] hover:text-[#f7f5f2] hover:bg-[#1a1815]"
};

const combinedClasses = `${baseStyles} ${sizeStyles[size]} ${variantStyles[variant]} ${className}`;
---

{
  href ? (
    <a href={href} class={combinedClasses} target={target} rel={rel} aria-label={ariaLabel}>
      <slot />
    </a>
  ) : (
    <button type={type} class={combinedClasses} aria-label={ariaLabel}>
      <slot />
    </button>
  )
}
