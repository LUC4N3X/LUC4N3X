---
import { siteConfig } from '../data/site';
---

<footer class="w-full border-t border-white/[0.08] bg-black py-16 sm:py-20 mt-20">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-10 mb-16">
      <div class="md:col-span-2 flex flex-col gap-4">
        <a href="/" class="flex items-center gap-3 w-fit">
          <div class="w-7 h-7 rounded-full overflow-hidden border border-white/[0.08] bg-white/[0.04] flex items-center justify-center">
            <img 
              src="/assets/brand/luc4n3x-mark.svg" 
              alt="LUC4N3X" 
              class="w-3.5 h-3.5 object-contain"
              width="14"
              height="14"
            />
          </div>
          <span class="font-semibold text-base tracking-tight text-white">LUC4N3X</span>
        </a>
        <p class="text-zinc-400 text-sm max-w-sm leading-relaxed font-normal">
          {siteConfig.motto}
        </p>
        <div class="inline-flex items-center gap-2 text-xs font-mono text-zinc-600">
          <span>Open source · Zero telemetry · Independent</span>
        </div>
      </div>

      <div class="flex flex-col gap-3">
        <span class="text-xs font-mono uppercase tracking-widest text-white font-semibold">
          Navigation
        </span>
        <ul class="space-y-2 text-sm">
          <li>
            <a href="/" class="text-zinc-400 hover:text-white transition-colors">Home</a>
          </li>
          <li>
            <a href="/projects" class="text-zinc-400 hover:text-white transition-colors">Projects</a>
          </li>
          <li>
            <a href="/articles" class="text-zinc-400 hover:text-white transition-colors">Articles & Notes</a>
          </li>
          <li>
            <a href="/projects/levyra" class="text-zinc-400 hover:text-white transition-colors">Levyra (DeepSound)</a>
          </li>
          <li>
            <a href="/about" class="text-zinc-400 hover:text-white transition-colors">About & Philosophy</a>
          </li>
          <li>
            <a href="/contact" class="text-zinc-400 hover:text-white transition-colors">Contact</a>
          </li>
          <li>
            <a href="/legal" class="text-zinc-400 hover:text-white transition-colors">Legal & Licensing</a>
          </li>
        </ul>
      </div>

      <div class="flex flex-col gap-3">
        <span class="text-xs font-mono uppercase tracking-widest text-white font-semibold">
          Ecosystem
        </span>
        <ul class="space-y-2 text-sm">
          <li>
            <a href="https://github.com/LUC4N3X" target="_blank" rel="noopener noreferrer" class="text-zinc-400 hover:text-white transition-colors">
              GitHub Profile ↗
            </a>
          </li>
          <li>
            <a href="https://github.com/LUC4N3X/Levyra-deepsound" target="_blank" rel="noopener noreferrer" class="text-zinc-400 hover:text-white transition-colors">
              Levyra Repository ↗
            </a>
          </li>
          <li>
            <a href="https://hosted.weblate.org/engage/levyra/" target="_blank" rel="noopener noreferrer" class="text-zinc-400 hover:text-white transition-colors">
              Weblate Translations ↗
            </a>
          </li>
          <li>
            <a href="https://github.com/LUC4N3X/LUC4N3X" target="_blank" rel="noopener noreferrer" class="text-zinc-400 hover:text-white transition-colors">
              Profile Source ↗
            </a>
          </li>
        </ul>
      </div>
    </div>

    <div class="pt-8 border-t border-white/[0.08] flex flex-col sm:flex-row items-center justify-between gap-4 text-xs font-mono text-zinc-500">
      <p>© {siteConfig.year} {siteConfig.name}. All rights reserved.</p>
      <div class="flex items-center gap-4">
        <span>Astro + Tailwind CSS</span>
        <span>·</span>
        <span>Cloudflare Pages</span>
      </div>
    </div>
  </div>
</footer>
