---
import SectionHeader from './SectionHeader.astro';
import { pressItems } from '../data/press';
---

<section class="py-20 sm:py-28 border-t border-[#24211d] bg-[#0e0d0c] relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <SectionHeader
      eyebrow="Ecosystem & Distribution"
      title="Recognition & Platforms"
      subtitle="Platforms, community hubs, and verified mirrors where LUC4N3X projects are published, localized, and referenced."
    />

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {pressItems.map(item => (
        <div class="rounded-3xl border border-[#27231e] bg-[#171513] p-7 flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between gap-2 mb-4">
              <span class="text-xs font-mono px-3 py-0.5 rounded-full bg-[#1c1916] border border-[#2e2a25] text-[#a39e94]">
                {item.badge}
              </span>
              <span class="text-[11px] font-mono text-[#6e6960]">
                {item.category}
              </span>
            </div>
            <h3 class="text-lg font-semibold text-[#f7f5f2] mb-2">
              {item.name}
            </h3>
            <p class="text-xs text-[#a39e94] leading-relaxed font-normal">
              {item.description}
            </p>
          </div>

          {item.url && (
            <div class="pt-5 mt-5 border-t border-[#26221d]">
              <a 
                href={item.url} 
                target="_blank" 
                rel="noopener noreferrer" 
                class="text-xs font-mono text-[#34a896] hover:underline inline-flex items-center gap-1 font-medium"
              >
                <span>Visit Platform</span>
                <span>↗</span>
              </a>
            </div>
          )}
        </div>
      ))}
    </div>
  </div>
</section>
