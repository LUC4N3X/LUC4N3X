---
import SectionHeader from './SectionHeader.astro';
import { pressItems } from '../data/press';
---

<section class="py-20 sm:py-28 border-t border-white/[0.08] bg-black relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <SectionHeader
      eyebrow="Ecosystem & Distribution"
      title="Recognition & Platforms"
      subtitle="Platforms, community hubs, and verified mirrors where LUC4N3X projects are published, localized, and referenced."
    />

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {pressItems.map(item => (
        <div class="rounded-2xl border border-white/[0.08] bg-[#0c0c0e] p-7 flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between gap-2 mb-4">
              <span class="text-xs font-mono px-3 py-0.5 rounded-full bg-white/[0.04] border border-white/[0.08] text-zinc-400">
                {item.badge}
              </span>
              <span class="text-[11px] font-mono text-zinc-500">
                {item.category}
              </span>
            </div>
            <h3 class="text-lg font-semibold text-white mb-2">
              {item.name}
            </h3>
            <p class="text-xs text-zinc-400 leading-relaxed font-normal">
              {item.description}
            </p>
          </div>

          {item.url && (
            <div class="pt-5 mt-5 border-t border-white/[0.08]">
              <a 
                href={item.url} 
                target="_blank" 
                rel="noopener noreferrer" 
                class="text-xs font-mono text-[#2997ff] hover:underline inline-flex items-center gap-1 font-medium"
              >
                <span>Visit Platform</span>
                <span>↗</span>
              </a>
            </div>
          )}
        </div>
      ))}
    </div>
  </div>
</section>
