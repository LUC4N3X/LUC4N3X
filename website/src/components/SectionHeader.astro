---
interface Props {
  eyebrow?: string;
  title: string;
  subtitle?: string;
  align?: "left" | "center";
  className?: string;
}

const { eyebrow, title, subtitle, align = "left", className = "" } = Astro.props;

const alignmentClasses = align === "center" ? "text-center items-center" : "text-left items-start";
---

<div class={`flex flex-col gap-2.5 mb-6 sm:mb-8 ${alignmentClasses} ${className}`}>
  {eyebrow && (
    <div class="inline-flex items-center gap-2">
      <span class="text-xs font-mono tracking-widest text-[#2997ff] uppercase font-semibold">
        {eyebrow}
      </span>
    </div>
  )}
  <h2 class="text-3xl sm:text-4xl md:text-5xl font-semibold tracking-tight text-white leading-tight">
    {title}
  </h2>
  {subtitle && (
    <p class="text-zinc-400 text-sm sm:text-base md:text-lg max-w-2xl leading-relaxed font-normal">
      {subtitle}
    </p>
  )}
</div>
