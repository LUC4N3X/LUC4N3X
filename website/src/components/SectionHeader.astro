---
interface Props {
  eyebrow?: string;
  title: string;
  subtitle?: string;
  align?: "left" | "center";
}

const { eyebrow, title, subtitle, align = "left" } = Astro.props;

const alignmentClasses = align === "center" ? "text-center items-center" : "text-left items-start";
---

<div class={`flex flex-col gap-3 mb-12 sm:mb-16 ${alignmentClasses}`}>
  {eyebrow && (
    <div class="inline-flex items-center gap-2">
      <span class="text-xs font-mono tracking-widest text-[#34a896] uppercase font-semibold">
        {eyebrow}
      </span>
    </div>
  )}
  <h2 class="text-3xl sm:text-4xl md:text-5xl font-semibold tracking-tight text-[#f7f5f2] leading-tight">
    {title}
  </h2>
  {subtitle && (
    <p class="text-[#a39e94] text-base sm:text-lg md:text-xl max-w-2xl leading-relaxed font-normal">
      {subtitle}
    </p>
  )}
</div>
