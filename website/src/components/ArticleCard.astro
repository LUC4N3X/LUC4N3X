---
import type { Article } from '../data/articles';
import TechBadge from './TechBadge.astro';

interface Props {
  article: Article;
}

const { article } = Astro.props;
---

<article class="group relative flex flex-col justify-between rounded-3xl border border-[#27231e] bg-[#171513] p-7 sm:p-8 transition-all duration-300 hover:border-[#3d372f] active:scale-[0.99]">
  <div>
    <div class="flex items-center justify-between gap-2 mb-4 text-xs font-mono text-[#736e65]">
      <time datetime={article.date}>
        {new Date(article.date).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}
      </time>
      <span class="px-2.5 py-0.5 rounded-full bg-[#1c1916] border border-[#2e2a25] text-[#a39e94]">
        {article.readingTime}
      </span>
    </div>

    <h3 class="text-xl font-semibold text-[#f7f5f2] tracking-tight mb-3 group-hover:text-[#48c9b0] transition-colors">
      <a href={`/articles/${article.slug}`} class="focus-visible:outline-none focus-visible:underline">
        {article.title}
      </a>
    </h3>

    <p class="text-sm text-[#a39e94] leading-relaxed mb-6 font-normal">
      {article.description}
    </p>
  </div>

  <div>
    <div class="flex flex-wrap gap-1.5 mb-6">
      {article.tags.map(tag => (
        <TechBadge text={tag} />
      ))}
    </div>

    <div class="flex items-center justify-between pt-4 border-t border-[#26221d] text-xs font-mono">
      <a 
        href={`/articles/${article.slug}`} 
        class="text-[#34a896] hover:text-[#48c9b0] font-medium transition-colors flex items-center gap-1.5"
      >
        <span>Read Article</span>
        <svg class="w-3.5 h-3.5 transform group-hover:translate-x-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      </a>

      <span class="text-[#736e65]">
        LUC4N3X Notes
      </span>
    </div>
  </div>
</article>
