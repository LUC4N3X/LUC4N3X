---
import type { Article } from '../data/articles';
import TechBadge from './TechBadge.astro';

interface Props {
  article: Article;
}

const { article } = Astro.props;
---

<article class="group relative flex flex-col justify-between rounded-2xl border border-white/[0.08] bg-[#0c0c0e] p-7 sm:p-8 transition-all duration-300 hover:border-white/[0.18] hover:bg-[#111114]">
  <div>
    <div class="flex items-center justify-between gap-2 mb-4 text-xs font-mono text-zinc-500">
      <time datetime={article.date}>
        {new Date(article.date).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}
      </time>
      <span class="px-2.5 py-0.5 rounded-full bg-white/[0.04] border border-white/[0.08] text-zinc-400">
        {article.readingTime}
      </span>
    </div>

    <h3 class="text-xl font-semibold text-white tracking-tight mb-3 group-hover:text-[#2997ff] transition-colors">
      <a href={`/articles/${article.slug}`} class="focus-visible:outline-none focus-visible:underline">
        {article.title}
      </a>
    </h3>

    <p class="text-sm text-zinc-400 leading-relaxed mb-6 font-normal">
      {article.description}
    </p>
  </div>

  <div>
    <div class="flex flex-wrap gap-1.5 mb-6">
      {article.tags.map(tag => (
        <TechBadge text={tag} />
      ))}
    </div>

    <div class="flex items-center justify-between pt-4 border-t border-white/[0.08] text-xs font-mono">
      <a 
        href={`/articles/${article.slug}`} 
        class="text-[#2997ff] hover:text-[#52a9ff] font-medium transition-colors flex items-center gap-1.5"
      >
        <span>Read Article</span>
        <svg class="w-3.5 h-3.5 transform group-hover:translate-x-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      </a>

      <span class="text-zinc-500">
        LUC4N3X Notes
      </span>
    </div>
  </div>
</article>
