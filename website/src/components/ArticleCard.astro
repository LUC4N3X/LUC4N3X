---
import type { Article } from '../data/articles';
import TechBadge from './TechBadge.astro';

interface Props {
  article: Article;
}

const { article } = Astro.props;

const categoryColors: Record<string, { bg: string; text: string; border: string }> = {
  "Android Internals": { bg: "bg-sky-500/15", text: "text-[#38bdf8]", border: "border-sky-500/30" },
  "Media3 & Audio": { bg: "bg-indigo-500/15", text: "text-[#818cf8]", border: "border-indigo-500/30" },
  "Zero Telemetry": { bg: "bg-emerald-500/15", text: "text-[#34d399]", border: "border-emerald-500/30" },
  "Reverse Engineering": { bg: "bg-rose-500/15", text: "text-[#f43f5e]", border: "border-rose-500/30" },
  "Craftsmanship": { bg: "bg-amber-500/15", text: "text-[#fbbf24]", border: "border-amber-500/30" }
};

const categoryStyle = categoryColors[article.category] || { bg: "bg-indigo-500/15", text: "text-[#818cf8]", border: "border-indigo-500/30" };
---

<article class="group relative flex flex-col justify-between rounded-3xl border border-white/[0.08] bg-[#0c101d]/90 backdrop-blur-sm p-7 sm:p-9 transition-all duration-300 hover:border-indigo-500/40 hover:bg-[#11172a] hover:shadow-2xl hover:shadow-indigo-500/15 hover:-translate-y-1">
  <div>
    <div class="flex items-center justify-between gap-2 mb-4 text-xs font-mono">
      <div class="flex items-center gap-2 text-zinc-400">
        <time datetime={article.date}>
          {new Date(article.date).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}
        </time>
        <span class="text-zinc-600">·</span>
        <span>{article.readingTime}</span>
      </div>
      
      <span class={`px-3 py-0.5 rounded-full text-xs font-mono font-medium ${categoryStyle.bg} border ${categoryStyle.border} ${categoryStyle.text}`}>
        {article.category}
      </span>
    </div>

    <h3 class="text-xl sm:text-2xl lg:text-[26px] font-bold text-white tracking-tight mb-3 group-hover:text-[#38bdf8] transition-colors leading-snug">
      <a href={`/articles/${article.slug}`} class="focus-visible:outline-none focus-visible:underline">
        {article.title}
      </a>
    </h3>

    <p class="text-sm sm:text-base text-zinc-400 leading-relaxed mb-6 font-normal">
      {article.description}
    </p>
  </div>

  <div>
    <div class="flex flex-wrap gap-1.5 mb-6">
      {article.tags.map(tag => (
        <TechBadge text={tag} size="sm" />
      ))}
    </div>

    <div class="flex items-center justify-between pt-4 border-t border-white/[0.08] text-xs font-mono">
      <a 
        href={`/articles/${article.slug}`} 
        class="text-[#38bdf8] group-hover:text-[#818cf8] font-medium transition-colors inline-flex items-center gap-2"
      >
        <span>Read Full Article</span>
        <svg class="w-4 h-4 transform group-hover:translate-x-1.5 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      </a>

      <span class="text-zinc-500">
        LUC4N3X Archive
      </span>
    </div>
  </div>
</article>
