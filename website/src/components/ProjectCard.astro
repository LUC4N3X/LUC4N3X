---
import type { Project } from '../data/projects';
import TechBadge from './TechBadge.astro';

interface Props {
  project: Project;
}

const { project } = Astro.props;
---

<div class="group relative flex flex-col justify-between rounded-2xl border border-white/[0.08] bg-[#0c0c0e] p-7 sm:p-8 transition-all duration-300 hover:border-white/[0.18] hover:bg-[#111114] active:scale-[0.99]">
  <div>
    <div class="flex items-center justify-between gap-2 mb-4">
      <div class="flex items-center gap-3">
        {project.icon && (
          <div class="w-8 h-8 rounded-xl overflow-hidden bg-white/[0.04] border border-white/[0.08] flex items-center justify-center p-1.5">
            <img src={project.icon} alt={project.name} class="w-full h-full object-contain" width="32" height="32" />
          </div>
        )}
        <h3 class="text-xl font-semibold text-white tracking-tight">
          {project.name}
        </h3>
      </div>
      <span class="text-[11px] font-mono px-3 py-0.5 rounded-full bg-white/[0.04] border border-white/[0.08] text-zinc-400">
        {project.status}
      </span>
    </div>

    <p class="text-xs font-mono text-[#2997ff] mb-3 tracking-wide">
      {project.tagline}
    </p>

    <p class="text-sm text-zinc-400 leading-relaxed mb-6 font-normal">
      {project.description}
    </p>

    <div class="mb-6 space-y-2 border-t border-b border-white/[0.08] py-4">
      {project.highlights.map(item => (
        <div class="flex items-start gap-2 text-xs text-zinc-400">
          <span class="text-[#2997ff] mt-0.5">·</span>
          <span>{item}</span>
        </div>
      ))}
    </div>
  </div>

  <div>
    <div class="flex flex-wrap gap-1.5 mb-6">
      {project.stack.map(tech => (
        <TechBadge text={tech} />
      ))}
    </div>

    <div class="flex items-center justify-between pt-4 border-t border-white/[0.08] text-xs font-mono">
      <div class="flex items-center gap-2">
        {project.platforms.map(p => (
          <span class="text-zinc-500">{p}</span>
        ))}
      </div>

      <div class="flex items-center gap-3">
        {project.internalUrl && (
          <a href={project.internalUrl} class="text-[#2997ff] hover:underline font-medium transition-colors">
            Overview →
          </a>
        )}
        <a 
          href={project.github} 
          target="_blank" 
          rel="noopener noreferrer" 
          class="text-zinc-400 hover:text-white transition-colors flex items-center gap-1"
        >
          <span>GitHub</span>
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
          </svg>
        </a>
      </div>
    </div>
  </div>
</div>
