---
import Layout from '../../layouts/Layout.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import FeaturedProject from '../../components/FeaturedProject.astro';
import { projects } from '../../data/projects';
import { siteConfig } from '../../data/site';

const nonFeaturedProjects = projects.filter(p => !p.featured);
---

<Layout 
  title={`Projects — ${siteConfig.name}`}
  description="Explore open-source software, media streaming engines, and developer tooling built by LUC4N3X."
>
  <div class="py-20 sm:py-28 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 bg-[#0e0d0c]">
    <SectionHeader
      eyebrow="Portfolio & Software"
      title="Open Source Projects"
      subtitle="Software, media engines, and infrastructure tools built with a focus on local performance, zero telemetry, and privacy."
    />

    <div class="mb-20">
      <FeaturedProject />
    </div>

    <div class="pt-8">
      <h3 class="text-2xl sm:text-3xl font-semibold text-[#f7f5f2] mb-8 tracking-tight">
        Additional Systems & Tooling
      </h3>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 lg:gap-8">
        {nonFeaturedProjects.map(project => (
          <ProjectCard project={project} />
        ))}
      </div>
    </div>
  </div>
</Layout>
