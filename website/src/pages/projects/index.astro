---
import Layout from '../../layouts/Layout.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import FeaturedProject from '../../components/FeaturedProject.astro';
import Button from '../../components/Button.astro';
import { projects } from '../../data/projects';
import { siteConfig } from '../../data/site';

const secondaryProjects = projects.filter(p => !p.featured);
---

<Layout 
  title={`Projects & Software — ${siteConfig.name}`}
  description="Open-source software, media playback systems, and developer utilities engineered by LUC4N3X with zero telemetry and local-first architecture."
>
  <div class="pt-20 sm:pt-28 pb-12 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 bg-black">
    <SectionHeader
      eyebrow="Portfolio & Software"
      title="Open Source Engineering"
      subtitle="Software and media playback systems engineered with an uncompromising focus on local performance, zero telemetry, and technical transparency."
    />
  </div>

  <FeaturedProject />

  <div class="py-20 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 bg-black">
    <div class="border-t border-white/[0.08] pt-16">
      <div class="mb-10">
        <h3 class="text-2xl sm:text-3xl font-semibold text-white tracking-tight">
          Additional Tools & Utilities
        </h3>
        <p class="text-zinc-400 text-sm sm:text-base mt-2 max-w-2xl font-normal">
          Lightweight specialized tools built for specific automation and media scraping workflows.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {secondaryProjects.map(project => (
          <div class="rounded-2xl border border-white/[0.08] bg-[#0c0c0e] p-8 flex flex-col justify-between transition-all duration-300 hover:border-white/[0.14]">
            <div>
              <div class="flex items-center justify-between gap-4 mb-4">
                <h4 class="text-xl font-semibold text-white tracking-tight">
                  {project.name}
                </h4>
                <span class="text-xs font-mono text-zinc-400 px-2.5 py-0.5 rounded-full bg-white/[0.04] border border-white/[0.08]">
                  {project.status}
                </span>
              </div>
              <p class="text-sm text-zinc-400 leading-relaxed mb-6 font-normal">
                {project.description}
              </p>
            </div>

            <div class="flex items-center justify-between gap-4 pt-6 border-t border-white/[0.08]">
              <div class="flex flex-wrap gap-2 text-xs font-mono text-zinc-400">
                {project.stack.map(t => (
                  <span class="text-zinc-500">#{t}</span>
                ))}
              </div>
              <Button href={project.github} target="_blank" variant="secondary" size="sm">
                <span>GitHub</span>
                <span class="ml-1">↗</span>
              </Button>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</Layout>
