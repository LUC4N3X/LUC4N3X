---
import Layout from '../../layouts/Layout.astro';
import Button from '../../components/Button.astro';
import TechBadge from '../../components/TechBadge.astro';
import PressSection from '../../components/PressSection.astro';
import { projects } from '../../data/projects';
import { siteConfig } from '../../data/site';
import { getLevyraMetrics, formatMetricNumber } from '../../utils/github';

const levyra = projects.find(p => p.id === 'levyra')!;
const metrics = await getLevyraMetrics();
const starsFormatted = formatMetricNumber(metrics.stars);
const downloadsFormatted = formatMetricNumber(metrics.downloads);

const screenshots = [
  {
    src: "/assets/levyra/home_top50.webp",
    title: "Home & Top 50",
    caption: "Discovery feed and regional charts with fast cover art loading."
  },
  {
    src: "/assets/levyra/player_nowplaying.webp",
    title: "Now Playing",
    caption: "Adaptive player sheet with waveform seekbar, codec badge, and queue controls."
  },
  {
    src: "/assets/levyra/lyrics_synced.webp",
    title: "Word-Synced Lyrics",
    caption: "60fps LRC and word-by-word lyrics with translation and romanization."
  },
  {
    src: "/assets/levyra/library_quickpicks.webp",
    title: "Quick Picks & Vault",
    caption: "Local library management and offline tracks stored on your device."
  },
  {
    src: "/assets/levyra/03_search_and_artist.webp",
    title: "Search & Artist View",
    caption: "Multi-source search across tracks, albums, artists, and community playlists."
  },
  {
    src: "/assets/levyra/04_library_and_pulse.webp",
    title: "Listening Pulse",
    caption: "On-device listening stats and history calculated locally without remote tracking."
  }
];

const levyraSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": "Levyra",
  "operatingSystem": "Android 8.0+, Windows 10/11 (x64)",
  "applicationCategory": "MultimediaApplication",
  "description": levyra.longDescription,
  "url": `${siteConfig.url}/projects/levyra`,
  "downloadUrl": levyra.releasesUrl,
  "softwareVersion": metrics.version,
  "author": {
    "@type": "Person",
    "name": "LUC4N3X",
    "url": siteConfig.url
  },
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  }
};
---

<Layout 
  title={`Levyra | Open-Source Music Player for Android & Windows by ${siteConfig.name}`}
  description={levyra.longDescription}
  image="/assets/levyra/levyra-lockup-dark.svg"
  schema={levyraSchema}
>
  <section class="relative pt-24 pb-16 sm:pt-32 sm:pb-24 border-b border-white/[0.08] bg-black">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="mb-10 flex justify-center">
        <img 
          src="/assets/levyra/levyra-lockup-dark.svg" 
          alt="Levyra Flagship Audio Engine" 
          class="w-full max-w-3xl h-auto rounded-2xl border border-white/[0.08] bg-[#0c0c0e] p-3 sm:p-5"
          width="1280"
          height="300"
        />
      </div>

      <div class="max-w-3xl mx-auto text-center">
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-white/[0.04] border border-white/[0.08] text-[#2997ff] text-xs font-mono mb-6">
          <span class="w-2 h-2 rounded-full bg-[#2997ff]"></span>
          <span>Open-Source Audio Player · Android &amp; Windows</span>
          <span data-levyra-version class="font-mono text-xs ml-1">v{metrics.version}</span>
        </div>

        <h1 class="text-4xl sm:text-6xl font-semibold tracking-tight text-white mb-6 leading-[1.08]">
          Verified 320 kbps audio and local library playback.
        </h1>

        <p class="text-base sm:text-xl text-zinc-400 leading-relaxed mb-8 font-normal">
          Levyra is a native music player for <strong class="text-zinc-200 font-medium">Android 8.0+</strong> and <strong class="text-zinc-200 font-medium">Windows 10/11 (x64)</strong>. It combines Jetpack Media3 on Android and libVLC on Windows with a shared Kotlin Multiplatform core, real-time spectral restoration for low-bitrate tracks, word-synced lyrics, and encrypted local backups.
        </p>

        <div class="flex flex-wrap items-center justify-center gap-3 mb-8">
          <div data-levyra-stars-container class="inline-flex items-center px-3.5 py-1.5 rounded-full bg-[#0c0c0e] border border-white/[0.08] text-xs font-mono text-zinc-400">
            <span class="text-amber-400">★</span>
            <span data-levyra-stars class="text-sm font-semibold text-white ml-1.5">{starsFormatted}</span>
            <span class="ml-1">GitHub Stars</span>
          </div>
          <div data-levyra-downloads-container class="inline-flex items-center px-3.5 py-1.5 rounded-full bg-[#0c0c0e] border border-white/[0.08] text-xs font-mono text-zinc-400">
            <span class="text-emerald-400">↓</span>
            <span data-levyra-downloads class="text-sm font-semibold text-white ml-1.5">{downloadsFormatted}</span>
            <span class="ml-1">Downloads</span>
          </div>
          <a href="https://apptizo.com/app/levyra/" target="_blank" rel="noopener noreferrer" class="inline-flex items-center px-3.5 py-1.5 rounded-full bg-[#0c0c0e] border border-white/[0.08] hover:border-emerald-400/40 text-xs font-mono text-emerald-400 transition-colors">
            <span>✓ 0 Trackers · 0 Ads (Apptizo Audit)</span>
          </a>
        </div>

        <div class="flex flex-wrap items-center justify-center gap-3 mb-10">
          <Button href={levyra.releasesUrl} variant="primary" size="lg" external>
            <span>Download Latest Release</span>
          </Button>
          <Button href={levyra.fdroidUrl} variant="secondary" size="lg" external>
            <span>Get on F-Droid</span>
          </Button>
          <Button href={levyra.github} variant="ghost" size="lg" external>
            <span>Source Code on GitHub ↗</span>
          </Button>
        </div>

        <div class="flex flex-wrap justify-center gap-2">
          {levyra.stack.map(tech => (
            <TechBadge text={tech} variant="accent" />
          ))}
        </div>
      </div>

    </div>
  </section>

  <section class="py-20 sm:py-28 border-b border-white/[0.08] bg-black">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto mb-14">
        <span class="text-xs font-mono uppercase tracking-widest text-[#2997ff] block mb-2">Interface Overview</span>
        <h2 class="text-3xl sm:text-4xl font-semibold text-white tracking-tight">Built around playback and lyrics</h2>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {screenshots.map(shot => (
          <div class="group rounded-2xl bg-[#0c0c0e] border border-white/[0.08] p-5 flex flex-col justify-between hover:border-white/[0.18] transition-all">
            <div class="rounded-xl overflow-hidden bg-black mb-4 flex items-center justify-center p-2">
              <img 
                src={shot.src} 
                alt={shot.title} 
                class="max-h-[420px] w-auto object-contain rounded-lg group-hover:scale-[1.01] transition-transform duration-300"
                loading="lazy"
              />
            </div>
            <div>
              <h3 class="text-base font-semibold text-white mb-1">{shot.title}</h3>
              <p class="text-xs text-zinc-400 leading-relaxed">{shot.caption}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="py-20 sm:py-28 border-b border-white/[0.08] bg-black">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
        
        <div class="lg:col-span-5">
          <span class="text-xs font-mono uppercase tracking-widest text-[#2997ff] block mb-2">Audio Pipeline &amp; Runtime</span>
          <h2 class="text-3xl sm:text-4xl font-semibold text-white tracking-tight mb-4">
            How Levyra works under the hood
          </h2>
          <p class="text-zinc-400 text-sm sm:text-base leading-relaxed mb-6 font-normal">
            Levyra shares its core logic and UI across Android and Windows with Kotlin Multiplatform, while binding to native audio engines on each OS instead of running inside a web wrapper.
          </p>
          <div class="p-6 rounded-2xl bg-[#0c0c0e] border border-white/[0.08] space-y-3 text-xs font-mono text-zinc-400">
            <div class="flex justify-between border-b border-white/[0.08] pb-2">
              <span class="text-zinc-500">Android Engine:</span>
              <span class="text-zinc-200">Jetpack Media3 / ExoPlayer</span>
            </div>
            <div class="flex justify-between border-b border-white/[0.08] pb-2">
              <span class="text-zinc-500">Windows Engine:</span>
              <span class="text-zinc-200">JVM 21 + libVLC (vlcj)</span>
            </div>
            <div class="flex justify-between border-b border-white/[0.08] pb-2">
              <span class="text-zinc-500">Stream Verification:</span>
              <span class="text-zinc-200">320 kbps AAC-LC (44.1 kHz)</span>
            </div>
            <div class="flex justify-between border-b border-white/[0.08] pb-2">
              <span class="text-zinc-500">DSP Restoration:</span>
              <span class="text-zinc-200">2048-pt FFT + IIR Hilbert SBR</span>
            </div>
            <div class="flex justify-between border-b border-white/[0.08] pb-2">
              <span class="text-zinc-500">Localization:</span>
              <span class="text-zinc-200">37 Languages (100% Android)</span>
            </div>
            <div class="flex justify-between">
              <span class="text-zinc-500">Trackers &amp; Ads:</span>
              <span class="text-emerald-400">0 Trackers · 0 Ad SDKs</span>
            </div>
          </div>
        </div>

        <div class="lg:col-span-7 grid grid-cols-1 sm:grid-cols-2 gap-5">
          <div class="p-7 rounded-2xl bg-[#0c0c0e] border border-white/[0.08]">
            <h3 class="text-lg font-semibold text-white mb-2 tracking-tight">Verified 320 kbps &amp; Local Lossless</h3>
            <p class="text-xs text-zinc-400 leading-relaxed">
              Streams genuine 320 kbps AAC-LC at 44.1 kHz stereo (verified up to 20 kHz via ffprobe and FFT spectrograms) alongside local FLAC, ALAC, WAV, OGG, and MP3 files.
            </p>
          </div>

          <div class="p-7 rounded-2xl bg-[#0c0c0e] border border-white/[0.08]">
            <h3 class="text-lg font-semibold text-white mb-2 tracking-tight">Levyra Enhanced Audio DSP</h3>
            <p class="text-xs text-zinc-400 leading-relaxed">
              Runs a 2048-point FFT analyzer to detect brickwall codec cutoffs on lower-bitrate tracks and rebuilds the upper band via single-sideband IIR Hilbert modulation, while bypassing 320 kbps and lossless files bit-identically.
            </p>
          </div>

          <div class="p-7 rounded-2xl bg-[#0c0c0e] border border-white/[0.08]">
            <h3 class="text-lg font-semibold text-white mb-2 tracking-tight">Native Windows Build (No Electron)</h3>
            <p class="text-xs text-zinc-400 leading-relaxed">
              Runs natively on JVM 21 with Compose Multiplatform (Skia on DirectX/OpenGL) and libVLC C bindings, using 60% to 75% less RAM than Chromium/Electron wrappers.
            </p>
          </div>

          <div class="p-7 rounded-2xl bg-[#0c0c0e] border border-white/[0.08]">
            <h3 class="text-lg font-semibold text-white mb-2 tracking-tight">10-Band EQ &amp; Audio Effects</h3>
            <p class="text-xs text-zinc-400 leading-relaxed">
              Includes a 10-band parametric equalizer, bass boost, virtualizer, loudness enhancer, crossfade, playback speed/pitch control, and silence skipping.
            </p>
          </div>

          <div class="p-7 rounded-2xl bg-[#0c0c0e] border border-white/[0.08]">
            <h3 class="text-lg font-semibold text-white mb-2 tracking-tight">Word-Synced Lyrics &amp; Translation</h3>
            <p class="text-xs text-zinc-400 leading-relaxed">
              Supports plain, line-synced LRC, and word-by-word karaoke lyrics with translation, romanization for CJK/Cyrillic/Arabic scripts, and tap-to-seek.
            </p>
          </div>

          <div class="p-7 rounded-2xl bg-[#0c0c0e] border border-white/[0.08]">
            <h3 class="text-lg font-semibold text-white mb-2 tracking-tight">Offline Vault &amp; Encrypted Backups</h3>
            <p class="text-xs text-zinc-400 leading-relaxed">
              Downloads tracks, artwork, and synced lyrics for offline listening, with password-encrypted local backup export and M3U8/CSV playlist import.
            </p>
          </div>
        </div>

      </div>
    </div>
  </section>

  <PressSection />

  <section class="py-20 sm:py-28 bg-black border-t border-white/[0.08]">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-3xl font-semibold text-white mb-4 tracking-tight">
        Download or build Levyra
      </h2>
      <p class="text-zinc-400 text-sm sm:text-base max-w-xl mx-auto mb-10 font-normal">
        Install signed binaries from GitHub Releases, F-Droid, IzzyOnDroid, Obtainium, or SourceForge, or help translate Levyra on Hosted Weblate.
      </p>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 text-left">
        <a href={levyra.releasesUrl} target="_blank" rel="noopener noreferrer" class="p-6 rounded-2xl bg-[#0c0c0e] border border-white/[0.08] hover:border-white/[0.18] transition-all">
          <div class="text-xs font-mono text-[#2997ff] mb-1">GitHub Releases</div>
          <div class="text-base font-semibold text-white mb-1">Android APK &amp; Windows MSI/EXE</div>
          <p class="text-xs text-zinc-400">Direct signed installers for Android 8.0+ and Windows 10/11 (x64).</p>
        </a>

        <a href={levyra.fdroidUrl} target="_blank" rel="noopener noreferrer" class="p-6 rounded-2xl bg-[#0c0c0e] border border-white/[0.08] hover:border-white/[0.18] transition-all">
          <div class="text-xs font-mono text-[#2997ff] mb-1">F-Droid Official</div>
          <div class="text-base font-semibold text-white mb-1">Reproducible Android Builds</div>
          <p class="text-xs text-zinc-400">Compiled from source and signed by the official F-Droid repository.</p>
        </a>

        <a href={levyra.izzyUrl} target="_blank" rel="noopener noreferrer" class="p-6 rounded-2xl bg-[#0c0c0e] border border-white/[0.08] hover:border-white/[0.18] transition-all">
          <div class="text-xs font-mono text-[#2997ff] mb-1">IzzyOnDroid</div>
          <div class="text-base font-semibold text-white mb-1">Fast F-Droid Repo</div>
          <p class="text-xs text-zinc-400">Rapid updates via the IzzyOnDroid repository with scanner checks.</p>
        </a>

        <a href={levyra.sourceforgeUrl} target="_blank" rel="noopener noreferrer" class="p-6 rounded-2xl bg-[#0c0c0e] border border-white/[0.08] hover:border-white/[0.18] transition-all">
          <div class="text-xs font-mono text-[#2997ff] mb-1">SourceForge</div>
          <div class="text-base font-semibold text-white mb-1">Global Release Mirror</div>
          <p class="text-xs text-zinc-400">Redundant mirror for all Android and Windows release binaries.</p>
        </a>

        <a href={levyra.weblateUrl} target="_blank" rel="noopener noreferrer" class="p-6 rounded-2xl bg-[#0c0c0e] border border-white/[0.08] hover:border-white/[0.18] transition-all">
          <div class="text-xs font-mono text-[#2997ff] mb-1">Hosted Weblate</div>
          <div class="text-base font-semibold text-white mb-1">Translate Levyra (37 Languages)</div>
          <p class="text-xs text-zinc-400">Contribute translations and review strings across 37 supported languages.</p>
        </a>

        <a href={levyra.github} target="_blank" rel="noopener noreferrer" class="p-6 rounded-2xl bg-[#0c0c0e] border border-white/[0.08] hover:border-white/[0.18] transition-all">
          <div class="text-xs font-mono text-[#2997ff] mb-1">GitHub Source</div>
          <div class="text-base font-semibold text-white mb-1">Browse Code &amp; Issues</div>
          <p class="text-xs text-zinc-400">Clone the repo, run the quality gates, or report bugs on GitHub.</p>
        </a>
      </div>
    </div>
  </section>
</Layout>
