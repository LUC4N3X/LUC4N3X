---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import FeaturedProject from '../components/FeaturedProject.astro';
import ArticleCard from '../components/ArticleCard.astro';
import PressSection from '../components/PressSection.astro';
import AboutSection from '../components/AboutSection.astro';
import OpenSourceSection from '../components/OpenSourceSection.astro';
import { articles } from '../data/articles';
import { pressMentions } from '../data/press';

const latestArticles = articles;
const recentPress = pressMentions.slice(0, 6);

const categories = [
  'Audio DSP',
  'Kotlin Multiplatform',
  'Jetpack Media3',
  'libVLC & Windows',
  'Zero Telemetry',
  'Arch Linux',
  'CLI Tooling',
  'APK Analysis'
];
---

<Layout>
  <Hero />

  <FeaturedProject />

  <section class="py-12 sm:py-20 bg-[#07090e] relative">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-start">
        
        <div class="lg:col-span-8">
          <div class="mb-8 border-b border-white/[0.08] pb-4 flex items-center justify-between">
            <div>
              <span class="text-xs font-mono uppercase tracking-[0.2em] text-[#f43f5e] font-bold block mb-1">
                Engineering Notes &amp; Deep Dives
              </span>
              <h2 class="text-2xl sm:text-3xl font-bold text-white tracking-tight">
                Latest Articles
              </h2>
            </div>
            <a href="/articles" class="text-xs font-mono text-[#38bdf8] hover:underline">
              All articles →
            </a>
          </div>

          <div class="divide-y divide-white/[0.06]">
            {latestArticles.map(article => (
              <ArticleCard article={article} />
            ))}
          </div>
        </div>

        <aside class="lg:col-span-4 space-y-12 lg:sticky lg:top-28">
          
          <div class="p-6 rounded-2xl bg-[#0d111a] border border-white/[0.08]">
            <h3 class="text-xs font-mono uppercase tracking-[0.2em] text-[#38bdf8] font-bold mb-4">
              Core Topics
            </h3>
            <div class="flex flex-wrap gap-2">
              {categories.map(cat => (
                <a 
                  href="/articles"
                  class="text-xs font-medium px-3 py-1.5 rounded-lg bg-white/[0.04] hover:bg-[#38bdf8]/15 text-slate-300 hover:text-[#38bdf8] border border-white/[0.06] hover:border-[#38bdf8]/30 transition-all duration-150"
                >
                  {cat}
                </a>
              ))}
            </div>
          </div>

          <div class="p-6 rounded-2xl bg-[#0d111a] border border-white/[0.08]">
            <div class="flex items-center justify-between mb-4">
              <h3 class="text-xs font-mono uppercase tracking-[0.2em] text-[#818cf8] font-bold">
                Featured Press ({pressMentions.length})
              </h3>
              <a href="/articles#press" class="text-[11px] font-mono text-slate-400 hover:text-white">
                View all →
              </a>
            </div>
            <ul class="space-y-4">
              {recentPress.map(item => (
                <li>
                  <a 
                    href={item.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="group flex items-start gap-3 text-sm text-slate-300 hover:text-white transition-colors"
                  >
                    <span class="text-[#38bdf8] font-mono text-xs mt-1 group-hover:translate-x-0.5 transition-transform">
                      ↗
                    </span>
                    <div>
                      <span class="font-medium leading-snug block group-hover:text-[#38bdf8] transition-colors">
                        {item.name}
                      </span>
                      <span class="text-[11px] font-mono text-slate-500 mt-0.5 block">
                        {item.category}
                      </span>
                    </div>
                  </a>
                </li>
              ))}
            </ul>
          </div>

          <div class="p-6 rounded-2xl bg-gradient-to-br from-[#101729] to-[#0b0f1c] border border-indigo-500/20">
            <span class="text-[11px] font-mono uppercase tracking-widest text-indigo-400 font-semibold block mb-2">
              Open Source Repository
            </span>
            <h4 class="text-lg font-bold text-white mb-2">
              Inspect the code on GitHub
            </h4>
            <p class="text-xs text-slate-400 leading-relaxed mb-4">
              All releases are built from public source with zero trackers and reproducible build pipelines.
            </p>
            <a 
              href="https://github.com/LUC4N3X" 
              target="_blank" 
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 text-xs font-mono font-bold text-[#38bdf8] hover:text-sky-300 transition-colors"
            >
              <span>github.com/LUC4N3X</span>
              <span>↗</span>
            </a>
          </div>

        </aside>

      </div>
    </div>
  </section>

  <PressSection />

  <AboutSection />

  <OpenSourceSection />
</Layout>
