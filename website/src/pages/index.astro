---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import FeaturedProject from '../components/FeaturedProject.astro';
import ArticleCard from '../components/ArticleCard.astro';
import SectionHeader from '../components/SectionHeader.astro';
import OpenSourceSection from '../components/OpenSourceSection.astro';
import AboutSection from '../components/AboutSection.astro';
import PressSection from '../components/PressSection.astro';
import ContactSection from '../components/ContactSection.astro';
import Button from '../components/Button.astro';
import { articles } from '../data/articles';
import { siteConfig } from '../data/site';

const featuredArticles = articles.slice(0, 2);
const topics = [
  { name: "Android Internals", color: "text-[#38bdf8] bg-sky-500/10 border-sky-500/20" },
  { name: "Media3 & Audio", color: "text-[#818cf8] bg-indigo-500/10 border-indigo-500/20" },
  { name: "Zero Telemetry", color: "text-[#34d399] bg-emerald-500/10 border-emerald-500/20" },
  { name: "Reverse Engineering", color: "text-[#f43f5e] bg-rose-500/10 border-rose-500/20" },
  { name: "Craftsmanship", color: "text-[#fbbf24] bg-amber-500/10 border-amber-500/20" }
];
---

<Layout 
  title={`${siteConfig.name} — ${siteConfig.tagline}`}
  description={siteConfig.description}
>
  <Hero />

  <FeaturedProject />

  <section class="py-20 sm:py-28 border-t border-white/[0.08] bg-[#080b11] relative">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col md:flex-row md:items-end justify-between mb-10 gap-4">
        <SectionHeader
          eyebrow="Engineering Notes & Architecture"
          title="Selected Writings"
          subtitle="Deep-dives into Android internals, audio decode pipelines, reverse engineering, and pragmatic software craftsmanship."
        />
        <Button href="/articles" variant="secondary" size="md">
          <span>All Articles ({articles.length})</span>
          <span class="ml-1">→</span>
        </Button>
      </div>

      <div class="flex flex-wrap items-center gap-2 mb-10">
        <span class="text-xs font-mono text-zinc-500 mr-2 uppercase tracking-wider">Browse by Topic:</span>
        {topics.map(topic => (
          <a 
            href="/articles" 
            class={`text-xs font-mono px-3 py-1 rounded-full border transition-all duration-200 hover:scale-105 ${topic.color}`}
          >
            {topic.name}
          </a>
        ))}
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 lg:gap-8">
        {featuredArticles.map(article => (
          <ArticleCard article={article} />
        ))}
      </div>
    </div>
  </section>

  <AboutSection />

  <OpenSourceSection />

  <PressSection />

  <ContactSection />
</Layout>
