---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import { siteConfig } from '../data/site';
---

<Layout 
  title={`Privacy & Legal | ${siteConfig.name}`}
  description="Privacy policy, open-source licensing, and zero-telemetry statement for LUC4N3X and Levyra."
>
  <PageHero
    eyebrow="Transparency & Terms"
    title="Privacy & Legal"
    subtitle="How this website and LUC4N3X software handle privacy, telemetry, and open-source licensing."
  />

  <section class="py-16 sm:py-24 bg-black">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 space-y-10 text-zinc-300 text-sm sm:text-base leading-relaxed">
      
      <div class="p-7 rounded-2xl bg-[#0c0c0e] border border-white/[0.08] space-y-3">
        <h2 class="text-xl font-semibold text-white tracking-tight">1. Zero-Telemetry Software Policy</h2>
        <p class="text-zinc-400 font-normal">
          Software developed and distributed by <strong class="text-white font-medium">LUC4N3X</strong> (including <strong class="text-white font-medium">Levyra</strong>) is built with zero telemetry. Our applications do not bundle analytics SDKs, advertising frameworks, or remote user profiling scripts.
        </p>
        <p class="text-zinc-400 font-normal">
          All user data, including playlists, offline tracks, equalizer settings, and listening history, is stored locally on your device.
        </p>
      </div>

      <div class="p-7 rounded-2xl bg-[#0c0c0e] border border-white/[0.08] space-y-3">
        <h2 class="text-xl font-semibold text-white tracking-tight">2. Website Privacy</h2>
        <p class="text-zinc-400 font-normal">
          This website is a static site built with Astro. It uses no tracking cookies, no behavioral analytics pixels, and no third-party advertising scripts.
        </p>
      </div>

      <div class="p-7 rounded-2xl bg-[#0c0c0e] border border-white/[0.08] space-y-3">
        <h2 class="text-xl font-semibold text-white tracking-tight">3. Open-Source Licensing</h2>
        <p class="text-zinc-400 font-normal">
          Each repository published under <a href="https://github.com/LUC4N3X" target="_blank" rel="noopener noreferrer" class="text-[#2997ff] hover:underline">github.com/LUC4N3X</a> contains its own <code class="font-mono text-xs bg-white/[0.06] px-1.5 py-0.5 rounded text-zinc-200">LICENSE</code> and <code class="font-mono text-xs bg-white/[0.06] px-1.5 py-0.5 rounded text-zinc-200">THIRD_PARTY_NOTICES.md</code> files governing source code usage, redistribution, and attribution.
        </p>
      </div>

      <div class="p-7 rounded-2xl bg-[#0c0c0e] border border-white/[0.08] space-y-3">
        <h2 class="text-xl font-semibold text-white tracking-tight">4. Contact</h2>
        <p class="text-zinc-400 font-normal">
          For legal inquiries, copyright questions, or security disclosures, contact <a href={`mailto:${siteConfig.email}`} class="text-[#2997ff] hover:underline font-mono">{siteConfig.email}</a>.
        </p>
      </div>

    </div>
  </section>
</Layout>
