---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import PressSection from '../../components/PressSection.astro';
import { articles } from '../../data/articles';
import { siteConfig } from '../../data/site';
---

<Layout 
  title={`Articles & Press | ${siteConfig.name}`}
  description="Technical notes on audio DSP, Kotlin Multiplatform, Jetpack Media3, and Arch Linux, plus external press reviews and spotlights on Levyra."
>
  <PageHero
    eyebrow="Technical Notes & Press"
    title="Articles & Reviews"
    subtitle="Engineering write-ups on audio DSP, Kotlin Multiplatform, and Linux tooling, followed by external articles and reviews featuring Levyra."
  />

  <section class="py-12 sm:py-20 bg-[#07090e]">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="mb-8 border-b border-white/[0.08] pb-4">
        <span class="text-xs font-mono uppercase tracking-[0.2em] text-[#38bdf8] font-bold block mb-1">
          Engineering Notes
        </span>
        <h2 class="text-2xl sm:text-3xl font-bold text-white tracking-tight">
          Technical Write-Ups ({articles.length})
        </h2>
      </div>

      <div class="divide-y divide-white/[0.08]">
        {articles.map(article => (
          <ArticleCard article={article} />
        ))}
      </div>
    </div>
  </section>

  <div id="press">
    <PressSection />
  </div>
</Layout>
