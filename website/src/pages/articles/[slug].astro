---
import Layout from '../../layouts/Layout.astro';
import TechBadge from '../../components/TechBadge.astro';
import Button from '../../components/Button.astro';
import { articles } from '../../data/articles';
import { siteConfig } from '../../data/site';

export function getStaticPaths() {
  return articles.map(article => ({
    params: { slug: article.slug },
    props: { article },
  }));
}

const { article } = Astro.props;

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": article.title,
  "description": article.excerpt,
  "datePublished": article.date,
  "author": {
    "@type": "Person",
    "name": "LUC4N3X",
    "url": siteConfig.url
  },
  "publisher": {
    "@type": "Person",
    "name": "LUC4N3X",
    "url": siteConfig.url
  },
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": `${siteConfig.url}/articles/${article.slug}`
  }
};
---

<Layout 
  title={`${article.title} | ${siteConfig.name}`}
  description={article.excerpt}
  type="article"
  schema={articleSchema}
>
  <article class="pt-28 pb-20 sm:pt-36 sm:pb-28 bg-black">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="mb-8">
        <a href="/articles" class="inline-flex items-center gap-1.5 text-xs font-mono text-zinc-400 hover:text-white transition-colors">
          <span>←</span>
          <span>Back to all articles</span>
        </a>
      </div>

      <header class="mb-12 pb-8 border-b border-white/[0.08]">
        <div class="flex items-center gap-3 text-xs font-mono text-zinc-500 mb-4">
          <span class="text-[#38bdf8] font-semibold">{article.category}</span>
          <span>·</span>
          <time datetime={article.date}>{article.date}</time>
          <span>·</span>
          <span>{article.readTime}</span>
        </div>

        <h1 class="text-3xl sm:text-5xl font-semibold text-white tracking-tight leading-[1.12] mb-6">
          {article.title}
        </h1>

        <p class="text-lg text-zinc-400 leading-relaxed mb-6 font-normal">
          {article.excerpt}
        </p>

        <div class="flex flex-wrap gap-2">
          {article.tags.map(tag => (
            <TechBadge text={tag} variant="accent" />
          ))}
        </div>
      </header>

      <div 
        class="prose prose-invert max-w-none space-y-6 text-zinc-300 leading-relaxed
               [&>h2]:text-2xl [&>h2]:font-semibold [&>h2]:text-white [&>h2]:mt-10 [&>h2]:mb-4 [&>h2]:tracking-tight
               [&>p]:text-base [&>p]:leading-relaxed [&>p]:text-zinc-300
               [&>ul]:list-disc [&>ul]:pl-6 [&>ul]:space-y-2 [&>ul]:text-zinc-300
               [&>ol]:list-decimal [&>ol]:pl-6 [&>ol]:space-y-2 [&>ol]:text-zinc-300
               [&_strong]:text-white [&_strong]:font-semibold
               [&_a]:text-[#2997ff] [&_a]:underline [&_code]:font-mono [&_code]:text-xs [&_code]:bg-white/[0.06] [&_code]:px-1.5 [&_code]:py-0.5 [&_code]:rounded [&_code]:text-[#2997ff]"
        set:html={article.content}
      />

      <footer class="mt-16 pt-8 border-t border-white/[0.08] flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
        <div>
          <div class="text-sm font-semibold text-white">Written by LUC4N3X</div>
          <div class="text-xs font-mono text-zinc-500">Independent software developer · Creator of Levyra</div>
        </div>
        <div class="flex items-center gap-3">
          <Button href="/projects/levyra" variant="secondary" size="sm">
            <span>Explore Levyra</span>
          </Button>
          <Button href="https://github.com/LUC4N3X" variant="ghost" size="sm" external>
            <span>GitHub ↗</span>
          </Button>
        </div>
      </footer>

    </div>
  </article>
</Layout>
