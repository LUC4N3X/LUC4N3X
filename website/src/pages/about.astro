---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import TechBadge from '../components/TechBadge.astro';
import Button from '../components/Button.astro';
import { skillCategories } from '../data/skills';
import { siteConfig } from '../data/site';
---

<Layout 
  title={`About | ${siteConfig.name}`}
  description="About LUC4N3X: independent software developer building Levyra, Linux CLI tools, and zero-telemetry software."
>
  <PageHero
    eyebrow="Identity & Stack"
    title="About LUC4N3X"
    subtitle="I build software I want to use, and keep working on it until it feels right."
  />

  <section class="py-16 sm:py-24 bg-black">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-20">
      
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
        <div class="lg:col-span-7 space-y-5 text-zinc-300 text-base leading-relaxed font-normal">
          <h2 class="text-2xl sm:text-3xl font-semibold text-white tracking-tight mb-4">
            How I approach software
          </h2>
          <p>
            I'm <strong class="text-white font-medium">LUC4N3X</strong>, an independent software developer based in Europe. Most of my work focuses on <strong class="text-white font-medium">Android and Windows development with Kotlin</strong>, <strong class="text-white font-medium">Linux command-line tools</strong>, and <strong class="text-white font-medium">low-level system and audio analysis</strong>.
          </p>
          <p>
            I care about performance, clear interfaces, and tools that respect the person using them. When you install an app I maintain, it starts without an account wall, keeps its database on your own storage, and never phones home to analytics or advertising networks.
          </p>
          <p>
            My main project is <a href="/projects/levyra" class="text-[#2997ff] hover:underline font-medium">Levyra</a>, an open-source music player for Android and Windows built with Kotlin Multiplatform, Jetpack Media3, and native libVLC. Alongside Levyra, I maintain my Arch Linux environment in <a href="https://github.com/LUC4N3X/thalarch-layer" target="_blank" rel="noopener noreferrer" class="text-[#2997ff] hover:underline font-medium">Thalarch Layer</a> and write small Python utilities like <a href="https://github.com/LUC4N3X/Instara-Crew" target="_blank" rel="noopener noreferrer" class="text-[#2997ff] hover:underline font-medium">Instara-Crew</a>.
          </p>
        </div>

        <div class="lg:col-span-5 p-8 rounded-2xl bg-[#0c0c0e] border border-white/[0.08] space-y-6">
          <div class="text-xs font-mono uppercase tracking-wider text-[#2997ff]">
            Working Principles
          </div>

          <div class="space-y-4">
            <div class="border-b border-white/[0.08] pb-4">
              <div class="text-sm font-semibold text-white mb-1">1. Local-First Ownership</div>
              <p class="text-xs text-zinc-400">Your playlists, listening history, and configuration files stay on your device in standard, exportable formats.</p>
            </div>
            <div class="border-b border-white/[0.08] pb-4">
              <div class="text-sm font-semibold text-white mb-1">2. Zero Telemetry by Default</div>
              <p class="text-xs text-zinc-400">No crash reporters, no behavioral analytics, and no ad SDKs. Verified by static APK scanners and F-Droid builds.</p>
            </div>
            <div class="border-b border-white/[0.08] pb-4">
              <div class="text-sm font-semibold text-white mb-1">3. Native Toolchains</div>
              <p class="text-xs text-zinc-400">Using Kotlin, Media3, libVLC, and shell tools directly instead of shipping a full Chromium browser for a desktop utility.</p>
            </div>
            <div>
              <div class="text-sm font-semibold text-white mb-1">4. Public History &amp; Real-Device Checks</div>
              <p class="text-xs text-zinc-400">Every commit, pull request, quality gate script, and release binary is public and inspectable on GitHub.</p>
            </div>
          </div>
        </div>
      </div>

      <div>
        <div class="mb-10">
          <span class="text-xs font-mono uppercase tracking-widest text-[#2997ff] block mb-2">Technical Stack</span>
          <h2 class="text-2xl sm:text-3xl font-semibold text-white tracking-tight">Areas of focus</h2>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          {skillCategories.map(cat => (
            <div class="p-7 rounded-2xl bg-[#0c0c0e] border border-white/[0.08] flex flex-col justify-between">
              <div>
                <span class="text-xs font-mono text-[#2997ff] block mb-1">{cat.subtitle}</span>
                <h3 class="text-xl font-semibold text-white mb-3 tracking-tight">{cat.title}</h3>
                <p class="text-xs text-zinc-400 leading-relaxed mb-6">
                  {cat.description}
                </p>
              </div>
              <div class="flex flex-wrap gap-1.5 pt-4 border-t border-white/[0.08]">
                {cat.skills.map(skill => (
                  <TechBadge text={skill} />
                ))}
              </div>
            </div>
          ))}
        </div>
      </div>

      <div class="rounded-2xl bg-[#0c0c0e] border border-white/[0.08] p-8 sm:p-10 flex flex-col sm:flex-row items-center justify-between gap-6">
        <div>
          <h3 class="text-xl font-semibold text-white mb-1 tracking-tight">Want to inspect the code or collaborate?</h3>
          <p class="text-sm text-zinc-400">Browse my repositories on GitHub or send me an email directly.</p>
        </div>
        <div class="flex flex-wrap items-center gap-3">
          <Button href="/projects" variant="primary" size="md">
            <span>View Projects</span>
          </Button>
          <Button href="/contact" variant="secondary" size="md">
            <span>Contact Me</span>
          </Button>
        </div>
      </div>

    </div>
  </section>
</Layout>
