---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import { socialLinks } from '../data/socials';
import { siteConfig } from '../data/site';
---

<Layout 
  title={`Contact | ${siteConfig.name}`}
  description="Get in touch with LUC4N3X via email or GitHub for bug reports, security disclosures, or open-source collaboration."
>
  <PageHero
    eyebrow="Direct Channels"
    title="Contact"
    subtitle="Reach out directly by email or through GitHub issues and pull requests."
  />

  <section class="py-16 sm:py-24 bg-black">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
      
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
        {socialLinks.map(item => (
          <a 
            href={item.href}
            target={item.href.startsWith('http') ? '_blank' : undefined}
            rel={item.href.startsWith('http') ? 'noopener noreferrer' : undefined}
            class="group p-7 rounded-2xl bg-[#0c0c0e] border border-white/[0.08] hover:border-white/[0.18] transition-all flex flex-col justify-between"
          >
            <div>
              <div class="flex items-center justify-between mb-3">
                <span class="text-xs font-mono uppercase tracking-wider text-zinc-400">{item.name}</span>
                <span class="text-zinc-600 group-hover:text-white transition-colors text-xs">↗</span>
              </div>
              <div class="text-lg font-semibold text-white group-hover:text-[#2997ff] transition-colors font-mono mb-2 break-all">
                {item.label}
              </div>
              <p class="text-xs text-zinc-400 leading-relaxed">
                {item.description}
              </p>
            </div>
          </a>
        ))}
      </div>

      <div class="p-8 rounded-2xl bg-[#0c0c0e] border border-white/[0.08]">
        <h2 class="text-lg font-semibold text-white mb-2 tracking-tight">Bug Reports &amp; Feature Requests</h2>
        <p class="text-sm text-zinc-400 leading-relaxed mb-4 font-normal">
          If you run into a playback issue or crash on Levyra, opening an issue on the <a href="https://github.com/LUC4N3X/Levyra-deepsound/issues" target="_blank" rel="noopener noreferrer" class="text-[#2997ff] hover:underline">Levyra GitHub Issue Tracker</a> with your device model and steps to reproduce is the fastest way to get it fixed. For security disclosures or private inquiries, email <a href={`mailto:${siteConfig.email}`} class="text-[#2997ff] hover:underline font-mono">{siteConfig.email}</a>.
        </p>
      </div>

    </div>
  </section>
</Layout>
